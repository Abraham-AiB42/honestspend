<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Floatpile_WinUI.Pages.ReconcilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="900">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Reconcile" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Books vs bank. Set institution balance from statement/Plaid, then trust bank or books." />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" />
            </Grid>
            <TextBlock x:Name="SummaryText" Opacity="0.85" TextWrapping="Wrap" />

            <ListView x:Name="AcctList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Opacity="0.75" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Button Content="Trust bank" Tag="{Binding}" Click="TrustBank_Click" />
                                    <Button Content="Trust books" Tag="{Binding}" Click="TrustBooks_Click" />
                                    <Button Content="Set bank bal…" Tag="{Binding}" Click="SetInst_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Card payment matches" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Cash outflows that look like card payments — confirm as transfers so books stay clean." />
                    <ItemsControl x:Name="PayList" />
                    <ComboBox x:Name="PayMatchBox" Header="Suggested payment match" HorizontalAlignment="Stretch"
                              PlaceholderText="Pick a match" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Confirm as transfer" Click="ConfirmPay_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="PayMsg" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="MsgText" Opacity="0.85" TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
