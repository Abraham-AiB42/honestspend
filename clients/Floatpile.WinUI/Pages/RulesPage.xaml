<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Floatpile_WinUI.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Category rules" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="When payee matches, assign a category. Learned from Sort charges — edit here anytime." />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" />
            </Grid>

            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />

            <ListView x:Name="RuleList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.7" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Delete" Tag="{Binding Id}"
                                        Click="Delete_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add rule" />
            <TextBox x:Name="PatternBox" Header="Payee text to match" PlaceholderText="e.g. AMAZON or NETFLIX"
                     TextChanged="Pattern_Changed" />
            <ComboBox x:Name="MatchBox" Header="How to match" SelectedIndex="0" SelectionChanged="Match_Changed">
                <ComboBoxItem Content="Contains (usual)" Tag="contains" />
                <ComboBoxItem Content="Starts with" Tag="starts_with" />
                <ComboBoxItem Content="Exact match" Tag="exact" />
                <ComboBoxItem Content="Regex (advanced)" Tag="regex" />
            </ComboBox>
            <ComboBox x:Name="CatBox" Header="Assign category" HorizontalAlignment="Stretch" />
            <NumberBox x:Name="PriorityBox" Header="Priority (higher wins if two match)" Value="100" />
            <CheckBox x:Name="TransferBox" Content="Treat as transfer (not spend)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Test pattern" Click="Test_Click" />
                <Button Content="Add rule" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <Border Padding="12" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="Would match (recent payees)" />
                    <TextBlock x:Name="TestSummaryText" Opacity="0.75" TextWrapping="Wrap"
                               Text="Type a pattern and tap Test (or wait a moment)." />
                    <ListView x:Name="TestMatchList" SelectionMode="None" MaxHeight="180" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="MsgText" Opacity="0.85" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
