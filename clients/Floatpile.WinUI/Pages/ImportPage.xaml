<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Floatpile_WinUI.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="720">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Import" />
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                    Text="Freeware path: download CSV from your bank (no passwords here), drop in inbox or pick a file. Plaid is optional BYOK." />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="How to download from your bank" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="We never store bank logins. Open your bank, export CSV, then import below or drop into the inbox." />
                    <ComboBox x:Name="BankGuideBox" Header="Institution" HorizontalAlignment="Stretch"
                              SelectionChanged="BankGuide_Changed" />
                    <HyperlinkButton x:Name="BankLoginLink" Content="Open bank login" NavigateUri="https://example.com"
                                     Visibility="Collapsed" />
                    <TextBlock x:Name="BankStepsText" Opacity="0.9" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="BankNotesText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Inbox drop folder" />
                    <TextBlock x:Name="InboxPathText" Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Text="…" />
                    <TextBlock x:Name="InboxFilesText" Opacity="0.85" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open inbox folder" Click="OpenInbox_Click" />
                        <Button Content="Import inbox now" Click="ImportInbox_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Refresh" Click="RefreshInbox_Click" />
                    </StackPanel>
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Tip: name files with account nicknames (e.g. Primary-checking.csv). Daily task Floatpile-ImportInbox can run this automatically." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Bank CSV (pick file)" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Export from Chase, Amex, etc. Map to one Floatpile account. Duplicates skipped." />
                    <ComboBox x:Name="AccountBox" Header="Target account" HorizontalAlignment="Stretch" />
                    <ComboBox x:Name="SignBox" Header="Amount sign" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Bank style (expenses negative)" Tag="bank" />
                        <ComboBoxItem Content="Invert signs" Tag="invert" />
                    </ComboBox>
                    <CheckBox x:Name="AutoCatBox" Content="Auto-categorize after import" IsChecked="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Pick CSV…" Click="PickCsv_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Pick PDF statement…" Click="PickPdf_Click" />
                        <TextBlock x:Name="CsvPathText" VerticalAlignment="Center" Opacity="0.75" Text="No file" />
                    </StackPanel>
                    <Button Content="Preview mapping" Click="PreviewCsv_Click" />
                    <TextBlock x:Name="PreviewText" Opacity="0.85" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Import CSV" Click="ImportCsv_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Import PDF statement" Click="ImportPdf_Click" />
                    </StackPanel>
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="PDF is best-effort on text statements only. Prefer CSV when the bank offers it." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Legacy Budget.xlsx" />
                    <ComboBox x:Name="ProfileSlugBox" Header="Entity" SelectedIndex="0" HorizontalAlignment="Stretch" />
                    <CheckBox x:Name="DryRunBox" Content="Dry run (scan only)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Pick xlsx…" Click="PickXlsx_Click" Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:Name="XlsxPathText" VerticalAlignment="Center" Opacity="0.75" Text="No file" />
                    </StackPanel>
                    <Button Content="Import xlsx" Click="ImportXlsx_Click" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Plaid" />
                    <TextBlock x:Name="PlaidText" Opacity="0.8" TextWrapping="Wrap" Text="Checking…" />
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Full connect / sync is under Banks (Plaid) in the nav. This is status only." />
                    <Button Content="Refresh Plaid status" Click="Plaid_Click" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ResultText" IsTextSelectionEnabled="True" TextWrapping="Wrap" Opacity="0.9" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
