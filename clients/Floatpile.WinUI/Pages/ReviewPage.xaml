<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Floatpile_WinUI.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sort a few charges" />
            <TextBlock Opacity="0.8" TextWrapping="Wrap"
                Text="We'll suggest a category. Tap Accept to teach the next time. About a minute when the queue is short." />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="EmptyTitle" FontWeight="SemiBold" Text="All clear" Visibility="Collapsed" />
                    <TextBlock x:Name="EmptyHint" Opacity="0.75" TextWrapping="Wrap" Visibility="Collapsed"
                        Text="Nothing waiting. Come back after imports or bank sync." />
                    <TextBlock x:Name="StatusText" Opacity="0.85" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh suggestions" Click="Suggest_Click" />
                        <Button Content="Accept confident ones" Click="ApplyHigh_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Accept all shown" Click="AcceptAll_Click" />
                    </StackPanel>
                    <CheckBox x:Name="GrokBox" Content="Use AI assist if configured (optional)" IsChecked="False" />
                </StackPanel>
            </Border>

            <ListView x:Name="ReviewList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.85" Text="{Binding Suggestion}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.65" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <Button Content="Looks right" Tag="{Binding}" Click="Accept_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{Binding AcceptVisible}" />
                                    <Button Content="Skip" Tag="{Binding}" Click="Skip_Click"
                                            Visibility="{Binding AcceptVisible}" />
                                    <TextBlock Text="{Binding Badge}" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
