<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="960">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Review queue" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Rules first, optional Grok. Accept teaches a merchant rule. Minimum daily effort." />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="GrokBox" Content="Use Grok if configured" IsChecked="False" />
                <Button Content="Suggest all" Click="Suggest_Click" />
                <Button Content="Auto-apply ≥85%" Click="ApplyHigh_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Opacity="0.8" />
            <ListView x:Name="ReviewList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.75" Text="{Binding Suggestion}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.6" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Button Content="Accept" Tag="{Binding}" Click="Accept_Click"
                                            Visibility="{Binding AcceptVisible}" />
                                    <TextBlock Text="{Binding Badge}" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
