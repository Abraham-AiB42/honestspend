<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Users &amp; API keys" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Local multi-role access. No key = desktop owner. Tokens send as X-API-Key." />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Current access" />
                    <TextBlock x:Name="MeText" TextWrapping="Wrap" />
                    <ItemsControl x:Name="CapList" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Roles" />
            <ItemsControl x:Name="RoleList" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Users" />
            <ListView x:Name="UserList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Opacity="0.7" Text="{Binding Subtitle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Rotate token" Tag="{Binding Id}"
                                        Click="Rotate_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add user" />
            <TextBox x:Name="UserNameBox" Header="Username" PlaceholderText="bookkeeper1" />
            <TextBox x:Name="DisplayBox" Header="Display name" PlaceholderText="Display name" />
            <ComboBox x:Name="RoleBox" Header="Role" SelectedIndex="3" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="owner" Tag="owner" />
                <ComboBoxItem Content="bookkeeper" Tag="bookkeeper" />
                <ComboBoxItem Content="cpa_viewer" Tag="cpa_viewer" />
                <ComboBoxItem Content="viewer" Tag="viewer" />
            </ComboBox>
            <CheckBox x:Name="IssueTokenBox" Content="Issue API token (shown once)" IsChecked="True" />
            <Button Content="Create user" Click="Create_Click" Style="{StaticResource AccentButtonStyle}" />

            <TextBlock x:Name="TokenText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                       FontFamily="Consolas" Opacity="0.9" />
            <TextBlock x:Name="MsgText" Opacity="0.8" TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
