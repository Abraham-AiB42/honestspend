<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="640">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="LedgerRing" />
            <TextBlock x:Name="VersionText" Opacity="0.8" Text="Connecting…" />
            <TextBlock x:Name="MaturityText" Opacity="0.75" TextWrapping="Wrap"
                Text="Pre-1.0 · product maturity ~65% dream (~0.6.5-class). Feature tags can read 0.9.x — that is not “almost 1.0.”" />
            <TextBlock TextWrapping="Wrap" FontSize="16">
                Open-source freeware multi-entity liquidity OS — not a bureau, not e-file, not payroll.
            </TextBlock>
            <TextBlock Opacity="0.8" TextWrapping="Wrap">
                • Never bounce checking&#x0a;
                • Prefer interest-free card float when it's safe&#x0a;
                • Catch dumb fees and unnecessary interest&#x0a;
                • Don't prepay cheap debt when cash yields more&#x0a;
                • Stay solvent first · credit health second&#x0a;
                • Local data + backup · open rarely
            </TextBlock>
            <TextBlock Opacity="0.7" TextWrapping="Wrap">
                Simple mode for daily use. Full books when you want ledgers and tax. Engine stays local on port 7420.
            </TextBlock>
            <TextBlock x:Name="PathsText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="LicenseText" Opacity="0.7" Text="MIT License · freeware · pre-1.0" />
        </StackPanel>
    </ScrollViewer>
</Page>
