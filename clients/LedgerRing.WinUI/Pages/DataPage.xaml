<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Data &amp; backup" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Local SQLite only. Backup to disk, OneDrive-friendly folder, or download ZIP." />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" />
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Live database" />
                    <TextBlock x:Name="DbPathText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <TextBlock x:Name="DbMetaText" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock x:Name="EngineText" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Auto-backup schedule" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="While the engine is running it checks every ~15 min. Keep copies under ~/.financial-os/backups." />
                    <CheckBox x:Name="AutoOnBox" Content="Enable scheduled auto-backup" IsChecked="True" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="IntervalBox" Header="Interval (hours)" Minimum="1" Maximum="720" Value="24" />
                        <NumberBox x:Name="KeepBox" Header="Keep last N backups" Minimum="1" Maximum="100" Value="14"
                                   Grid.Column="1" />
                    </Grid>
                    <TextBlock x:Name="ScheduleMeta" Opacity="0.75" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save schedule" Click="SaveSchedule_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Run auto-backup now" Click="RunAuto_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Create backup" Click="Create_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Download live ZIP…" Click="DownloadLive_Click" />
                <Button Content="Restore from file…" Click="RestoreUpload_Click" />
            </StackPanel>
            <TextBox x:Name="NoteBox" Header="Backup note (optional)" PlaceholderText="before tax season" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Encrypted cloud snapshot" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="AES-256-GCM (.lrenc). Copy to any folder you choose (OneDrive, Dropbox, etc.). Not a live multi-writer DB." />
                    <TextBox x:Name="RemoteFolderBox" Header="Destination folder"
                             PlaceholderText="C:\Users\…\OneDrive\LedgerRing\backups" />
                    <CheckBox x:Name="AutoCopyEncBox" Content="Copy encrypted backups to destination" IsChecked="True" />
                    <PasswordBox x:Name="EncPassBox" Header="Encryption password (min 8 chars)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save destination" Click="SaveRemote_Click" />
                        <Button Content="Create encrypted backup" Click="CreateEnc_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="RemoteHintText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Saved backups" />
            <ListView x:Name="BackupList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" IsTextSelectionEnabled="True" />
                                    <TextBlock Opacity="0.7" Text="{Binding Meta}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Save as…" Tag="{Binding Name}" Click="DownloadNamed_Click" />
                                    <Button Content="Restore" Tag="{Binding Name}" Click="RestoreNamed_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="MsgText" Opacity="0.85" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
            <InfoBar x:Name="WarnBar" IsClosable="True" IsOpen="False" Severity="Warning"
                     Title="Restart recommended after restore" />
        </StackPanel>
    </ScrollViewer>
</Page>
