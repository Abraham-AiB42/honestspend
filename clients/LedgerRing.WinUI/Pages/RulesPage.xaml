<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Category rules" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Merchant patterns learned from Review. Rules first; Grok optional." />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" />
            </Grid>

            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap" />

            <ListView x:Name="RuleList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.7" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Delete" Tag="{Binding Id}"
                                        Click="Delete_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add rule" />
            <TextBox x:Name="PatternBox" Header="Pattern (payee contains / exact)" PlaceholderText="AMAZON" />
            <ComboBox x:Name="MatchBox" Header="Match type" SelectedIndex="0">
                <ComboBoxItem Content="contains" Tag="contains" />
                <ComboBoxItem Content="starts_with" Tag="starts_with" />
                <ComboBoxItem Content="exact" Tag="exact" />
                <ComboBoxItem Content="regex" Tag="regex" />
            </ComboBox>
            <ComboBox x:Name="CatBox" Header="Category" HorizontalAlignment="Stretch" />
            <NumberBox x:Name="PriorityBox" Header="Priority (higher wins)" Value="100" />
            <CheckBox x:Name="TransferBox" Content="Mark as transfer" />
            <Button Content="Add rule" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />

            <TextBlock x:Name="MsgText" Opacity="0.85" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
