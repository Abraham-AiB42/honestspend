<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.BuyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Can I buy this?" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Protects checking and prefers interest-free card float when it's safe. Uses Who / money view from the top bar." />

            <NumberBox x:Name="AmountBox" Header="Amount ($)" Minimum="0.01"
                       SpinButtonPlacementMode="Inline" Value="100" />
            <ComboBox x:Name="PreferBox" Header="Prefer" SelectedIndex="0" MinWidth="280">
                <ComboBoxItem Content="Auto (card float if safe, else cash)" Tag="auto" />
                <ComboBoxItem Content="Cash first" Tag="cash" />
                <ComboBoxItem Content="Card first" Tag="card" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check purchase" Click="Check_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="What if I buy it?" Click="Simulate_Click" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="VerdictText" FontSize="24" FontWeight="SemiBold" Text="—" />
                    <TextBlock x:Name="RecText" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReasonText" Opacity="0.85" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Options" Margin="0,8,0,0" />
                    <ItemsControl x:Name="OptionsList" />
                    <TextBlock x:Name="ScopeText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="SimText" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
