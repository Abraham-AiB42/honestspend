<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.MoneyWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="14" MaxWidth="520">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Wizard" />
            <TextBlock x:Name="StepText" Opacity="0.7" />
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="HintText" Opacity="0.75" TextWrapping="Wrap" />

            <StackPanel x:Name="FieldsPanel" Spacing="12" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackBtn" Content="Back" Click="Back_Click" />
                <Button x:Name="NextBtn" Content="Next" Style="{StaticResource AccentButtonStyle}" Click="Next_Click" />
                <Button Content="Cancel" Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="MsgText" TextWrapping="Wrap" Opacity="0.85" />
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
