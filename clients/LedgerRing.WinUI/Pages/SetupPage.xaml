<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Quick setup" />
            <TextBlock Opacity="0.8" TextWrapping="Wrap"
                Text="Minimum time to first Spendable number. No spreadsheet required. You can edit everything later." />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Status" />
                    <TextBlock x:Name="StatusSummary" TextWrapping="Wrap" />
                    <ItemsControl x:Name="Checklist" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Starter accounts" />
            <ComboBox x:Name="ProfileSlugBox" Header="Entity (add more under Entities)" SelectedIndex="0" HorizontalAlignment="Stretch" />
            <TextBox x:Name="CashNameBox" Header="Checking nickname" Text="Primary checking" />
            <TextBox x:Name="InstBox" Header="Institution (optional)" PlaceholderText="Chase, Amex…" />
            <NumberBox x:Name="CashBalBox" Header="Checking balance ($)" Value="0" Minimum="0" />
            <NumberBox x:Name="BufferBox" Header="Safety buffer ($)" Value="1000" Minimum="0" />
            <ComboBox x:Name="ModeBox" Header="IFPP mode" SelectedIndex="0">
                <ComboBoxItem Content="conservative" Tag="conservative" />
                <ComboBoxItem Content="expected" Tag="expected" />
            </ComboBox>

            <CheckBox x:Name="AddCardBox" Content="Also add a credit card" IsChecked="False"
                      Checked="CardToggle" Unchecked="CardToggle" />
            <StackPanel x:Name="CardPanel" Spacing="10" Visibility="Collapsed">
                <TextBox x:Name="CardNameBox" Header="Card nickname" PlaceholderText="Amex 0%" />
                <NumberBox x:Name="CardBalBox" Header="Balance owed ($)" Value="0" Minimum="0" />
                <NumberBox x:Name="CardLimitBox" Header="Credit limit ($)" Minimum="0" />
                <NumberBox x:Name="CardDueBox" Header="Payment due day (1–31)" Minimum="1" Maximum="31" Value="15" />
                <NumberBox x:Name="PromoAprBox" Header="Promo APR (0 for 0%)" Value="0" Minimum="0" />
                <CalendarDatePicker x:Name="PromoEndBox" Header="Promo end (optional)" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Run quick setup" Click="Setup_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Skip — mark complete" Click="Skip_Click" />
                <Button Content="Go to Spendable" Click="Home_Click" />
            </StackPanel>

            <TextBlock x:Name="MsgText" Opacity="0.85" TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
