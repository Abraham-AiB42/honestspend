<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LedgerRing_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Start the engine" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="LedgerRing runs a local money engine. The app usually starts it for you — tap Start if Home says offline." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Start / ping engine" Click="StartEngine_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Start tray now" Click="StartTray_Click" />
                <Button Content="Stop tray" Click="StopTray_Click" />
                <Button Content="Show window" Click="ShowWindow_Click" />
            </StackPanel>
            <TextBlock x:Name="EngineLogText" Opacity="0.6" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Startup shortcuts" />
            <CheckBox x:Name="TrayAutoBox" Content="Start system tray with app" />
            <CheckBox x:Name="MinimizedBox" Content="Start minimized" />
            <CheckBox x:Name="LoginBox" Content="Launch at Windows logon (tray only — engine quietly ready)" />
            <TextBlock x:Name="StartupStatusText" Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                Text="Tip: tray keeps Safe to spend a click away. Double-click tray opens this desktop app (not a browser)." />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Automation (Windows)" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Client-first: schedule local backup + daily digest via Task Scheduler. No cloud, no PWA." />
            <Border Padding="12" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Task status" />
                    <TextBlock x:Name="TaskStatusText" Opacity="0.8" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Text="Checking Task Scheduler…" />
                    <Button Content="Refresh status" Click="RefreshTasks_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Register scheduled tasks" Click="RegisterTasks_Click" />
                <Button Content="Remove scheduled tasks" Click="UnregisterTasks_Click" />
            </StackPanel>
            <TextBlock x:Name="AutomationStatusText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />

            <Expander Header="Connection &amp; data (advanced)" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <TextBox
                        x:Name="BaseUrlBox"
                        Header="API base URL"
                        Text="http://127.0.0.1:7420" />
                    <PasswordBox x:Name="ApiKeyBox" Header="Optional API key (multi-user)" />
                    <TextBox
                        x:Name="BackendRootBox"
                        Header="Engine folder (auto-detect is fine)"
                        PlaceholderText="Repo root or .\engine" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Data stays on this PC (or your OneDrive folder). Not a multi-device live DB — use encrypted backups for another machine." />
                    <TextBox x:Name="DataDirBox" Header="Data folder (empty = default)"
                             PlaceholderText="C:\Users\…\OneDrive\LedgerRing\data" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Suggest OneDrive" Click="SuggestOneDrive_Click" />
                        <Button Content="Use default home" Click="DefaultDataDir_Click" />
                        <Button Content="Copy DB to path…" Click="CopyDataDir_Click" />
                        <Button Content="Save connection" Click="Save_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PathsHintText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Expander>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Money in (freeware)" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Download CSV/OFX or statements from your bank, then Import. Reminders are local only — no bank passwords, no paid feed. Optional live link = your Plaid keys; optional AI = your xAI key." />
            <ComboBox x:Name="ImportCadenceBox" Header="Import reminder cadence" SelectedIndex="2" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Off — I update myself" Tag="off" />
                <ComboBoxItem Content="Daily" Tag="daily" />
                <ComboBoxItem Content="Weekly (recommended)" Tag="weekly" IsSelected="True" />
                <ComboBoxItem Content="Monthly (open rarely / statements)" Tag="monthly" />
            </ComboBox>
            <ComboBox x:Name="ImportFocusBox" Header="Remind me about" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Transactions CSV/OFX" Tag="transactions" IsSelected="True" />
                <ComboBoxItem Content="Monthly statements" Tag="statements" />
                <ComboBoxItem Content="Both" Tag="both" />
            </ComboBox>
            <TextBlock x:Name="ImportReminderStatusText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save money-in settings" Click="SaveImportReminder_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Snooze 7 days" Click="SnoozeImport_Click" />
                <Button Content="Mark refreshed now" Click="AckImport_Click" />
            </StackPanel>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Everyday safety" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                Text="Rainy-day floor stays out of Safe to spend. Protect checking on big outflows." />
            <NumberBox x:Name="BufferBox" Header="Rainy-day floor ($)" Minimum="0" Value="1000" />
            <ComboBox x:Name="NeverNegEnforceBox" Header="Protect checking when posting expenses" SelectedIndex="1">
                <ComboBoxItem Content="Off (just warn later)" Tag="off" />
                <ComboBoxItem Content="Ask me first (recommended)" Tag="warn" IsSelected="True" />
                <ComboBoxItem Content="Always block" Tag="hard" />
            </ComboBox>
            <Button Content="Save safety settings" Click="SaveFiscal_Click" Style="{StaticResource AccentButtonStyle}" />

            <Expander Header="Advanced (power user)" IsExpanded="False" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Padding="0,12,0,0">
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="These map to engine knobs. Simple mode never needs them." />
                    <ComboBox x:Name="ModeBox" Header="Safe-to-spend carefulness" SelectedIndex="0">
                        <ComboBoxItem Content="Careful" Tag="conservative" />
                        <ComboBoxItem Content="Optimistic" Tag="expected" />
                    </ComboBox>
                    <ComboBox x:Name="ScopeBox" Header="Never-negative pool" SelectedIndex="0">
                        <ComboBoxItem Content="checking only" Tag="checking" />
                        <ComboBoxItem Content="all cash accounts" Tag="all_cash" />
                    </ComboBox>
                    <NumberBox x:Name="HorizonBox" Header="Look-ahead days" Minimum="7" Maximum="365" Value="45" />
                    <NumberBox x:Name="OppRateBox" Header="Cash yield hurdle (e.g. 0.06)" Minimum="0" Maximum="1"
                               PlaceholderText="vs cheap debt" />
                    <CheckBox x:Name="OppAwareBox" Content="Opportunity-cost aware debt plan" IsChecked="True" />
                    <ComboBox x:Name="DebtBox" Header="Debt payoff style" SelectedIndex="0">
                        <ComboBoxItem Content="Highest APR first" Tag="avalanche" />
                        <ComboBoxItem Content="Smallest balance first" Tag="snowball" />
                        <ComboBoxItem Content="Opportunity-aware" Tag="opportunity" />
                    </ComboBox>
                    <NumberBox x:Name="ExtraBox" Header="Extra $/month toward debt" Minimum="0" Value="0" />
                    <CheckBox x:Name="AutoCatBox" Content="Auto-categorize on import" IsChecked="True" />
                    <CheckBox x:Name="ClearedOnlyBox" Content="Flag pending before trusting books" IsChecked="True" />
                    <ComboBox x:Name="IfppScopeDefaultBox" Header="Default money view" SelectedIndex="0">
                        <ComboBoxItem Content="This money (silo)" Tag="entity" />
                        <ComboBoxItem Content="All money (combined)" Tag="group" />
                    </ComboBox>
                    <Button Content="Save advanced settings" Click="SaveFiscal_Click" />
                </StackPanel>
            </Expander>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />

            <TextBlock
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="WinUI is the native Windows UI. The fiscal engine stays Python. No Electron/Tauri wrapper." />
        </StackPanel>
    </ScrollViewer>
</Page>
