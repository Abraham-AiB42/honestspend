<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.BillsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Bills &amp; income" />
                    <TextBlock Opacity="0.7" Text="Recurring · Pay from cash or credit · series amount steps" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add bill wizard" Click="WizardBill_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Add income" Click="WizardIncome_Click" />
                    <Button Content="Owner draw" Click="WizardOwnerDraw_Click" />
                    <Button Content="Refresh" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <ListView x:Name="BillList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Opacity="0.75" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Mark paid" Tag="{Binding Id}"
                                            Click="MarkPaid_Click"
                                            Visibility="{Binding MarkPaidVisible}"
                                            ToolTipService.ToolTip="Record this bill as paid and advance the next date" />
                                    <Button Content="Change amount on date…" Tag="{Binding Id}"
                                            Click="ChangeAmount_Click"
                                            Visibility="{Binding StepVisible}" />
                                    <Button Content="End" Tag="{Binding Id}" Click="End_Click"
                                            Visibility="{Binding EndVisible}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add recurring" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="KindBox" Header="Kind" SelectedIndex="0" Grid.Row="0" Grid.Column="0"
                          SelectionChanged="Kind_Changed">
                    <ComboBoxItem Content="Bill" Tag="expense" />
                    <ComboBoxItem Content="Income" Tag="income" />
                    <ComboBoxItem Content="Owner draw" Tag="owner_draw" />
                </ComboBox>
                <ComboBox x:Name="ProfileBox" Header="Who" Grid.Row="0" Grid.Column="1" SelectionChanged="Profile_Changed" />

                <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Housing, Netflix, Paycheck, Owner draw"
                         Grid.Row="1" Grid.Column="0" />
                <NumberBox x:Name="AmtBox" Header="Amount ($ positive)" Minimum="0" Value="0"
                           Grid.Row="1" Grid.Column="1" />

                <ComboBox x:Name="AccountBox" Header="Pay from" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                          HorizontalAlignment="Stretch" />

                <TextBox x:Name="VendorBox" Header="Vendor" PlaceholderText="Who you pay (optional)"
                         Grid.Row="3" Grid.Column="0" />
                <TextBox x:Name="IncomeSourceBox" Header="Income source" PlaceholderText="Job, retainers, rent…"
                         Grid.Row="3" Grid.Column="1" Visibility="Collapsed" />

                <CalendarDatePicker x:Name="StartDateBox" Header="Starts" Grid.Row="4" Grid.Column="0" />
                <CalendarDatePicker x:Name="EndDateBox" Header="Ends (optional)" Grid.Row="4" Grid.Column="1" />

                <CalendarDatePicker x:Name="NextDateBox" Header="Next date" Grid.Row="5" Grid.Column="0" />
                <ComboBox x:Name="CadenceBox" Header="How often" SelectedIndex="3" Grid.Row="5" Grid.Column="1">
                    <ComboBoxItem Content="Weekly" Tag="weekly" />
                    <ComboBoxItem Content="Every 2 weeks" Tag="biweekly" />
                    <ComboBoxItem Content="Twice a month" Tag="semimonthly" />
                    <ComboBoxItem Content="Monthly" Tag="monthly" />
                    <ComboBoxItem Content="Yearly" Tag="yearly" />
                </ComboBox>

                <ComboBox x:Name="OpexBox" Header="Opex class (business)" SelectedIndex="0"
                          Grid.Row="6" Grid.Column="0" Visibility="Collapsed">
                    <ComboBoxItem Content="Fixed" Tag="fixed" />
                    <ComboBoxItem Content="Variable" Tag="variable" />
                </ComboBox>
                <ComboBox x:Name="CertaintyBox" Header="How sure?" SelectedIndex="0"
                          Grid.Row="6" Grid.Column="1" MinWidth="220">
                    <ComboBoxItem Content="Fixed amount" Tag="fixed" />
                    <ComboBoxItem Content="Expected (usual)" Tag="expected" />
                    <ComboBoxItem Content="Historical average" Tag="historical_avg" />
                </ComboBox>
            </Grid>
            <Button Content="Save recurring" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:Name="MsgText" Opacity="0.8" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Payroll day (business)"
                       Margin="0,16,0,0" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Creates two cash bills on the same pay date: net payroll and employer tax. Both hit Safe to spend / Coming up. Use checking as pay from." />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="PayrollNameBox" Header="Name" PlaceholderText="Biweekly payroll"
                         Text="Biweekly payroll" Grid.Row="0" Grid.Column="0" />
                <ComboBox x:Name="PayrollCadenceBox" Header="How often" SelectedIndex="1" Grid.Row="0" Grid.Column="1">
                    <ComboBoxItem Content="Weekly" Tag="weekly" />
                    <ComboBoxItem Content="Every 2 weeks" Tag="biweekly" IsSelected="True" />
                    <ComboBoxItem Content="Twice a month" Tag="semimonthly" />
                    <ComboBoxItem Content="Monthly" Tag="monthly" />
                </ComboBox>
                <CalendarDatePicker x:Name="PayrollDateBox" Header="Next pay date" Grid.Row="1" Grid.Column="0" />
                <ComboBox x:Name="PayrollCashBox" Header="Pay from (cash)" Grid.Row="1" Grid.Column="1"
                          HorizontalAlignment="Stretch" />
                <NumberBox x:Name="PayrollNetBox" Header="Net payroll ($)" Minimum="0" Value="0"
                           Grid.Row="2" Grid.Column="0" />
                <NumberBox x:Name="PayrollTaxBox" Header="Employer tax ($)" Minimum="0" Value="0"
                           Grid.Row="2" Grid.Column="1" />
                <Button Content="Create payroll day" Click="PayrollPackage_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" />
            </Grid>
            <TextBlock x:Name="PayrollMsgText" Opacity="0.8" TextWrapping="Wrap" />

            <InfoBar x:Name="SuccessBar" IsClosable="True" IsOpen="False" Severity="Success" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
