<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.BillsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="960">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Bills &amp; income" />
                    <TextBlock Opacity="0.7" Text="Recurring · must attach expenses to an account/card" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add bill wizard" Click="WizardBill_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Add income" Click="WizardIncome_Click" />
                    <Button Content="Refresh" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <ListView x:Name="BillList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Opacity="0.75" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="End" Tag="{Binding Id}" Click="End_Click"
                                        Visibility="{Binding EndVisible}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add recurring" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="KindBox" Header="Type" SelectedIndex="0" Grid.Row="0" Grid.Column="0">
                    <ComboBoxItem Content="Expense / bill" Tag="expense" />
                    <ComboBoxItem Content="Income" Tag="income" />
                </ComboBox>
                <ComboBox x:Name="ProfileBox" Header="Who" Grid.Row="0" Grid.Column="1" SelectionChanged="Profile_Changed" />

                <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Housing, Netflix, Paycheck" Grid.Row="1" Grid.Column="0" />
                <NumberBox x:Name="AmtBox" Header="Amount ($ positive)" Minimum="0" Value="0" Grid.Row="1" Grid.Column="1" />

                <ComboBox x:Name="AccountBox" Header="Account / Card" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" />

                <CalendarDatePicker x:Name="NextDateBox" Header="Next date" Grid.Row="3" Grid.Column="0" />
                <ComboBox x:Name="CadenceBox" Header="How often" SelectedIndex="3" Grid.Row="3" Grid.Column="1">
                    <ComboBoxItem Content="Weekly" Tag="weekly" />
                    <ComboBoxItem Content="Every 2 weeks" Tag="biweekly" />
                    <ComboBoxItem Content="Twice a month" Tag="semimonthly" />
                    <ComboBoxItem Content="Monthly" Tag="monthly" />
                    <ComboBoxItem Content="Yearly" Tag="yearly" />
                </ComboBox>
            </Grid>
            <ComboBox x:Name="CertaintyBox" Header="How sure?" SelectedIndex="0" MinWidth="220">
                <ComboBoxItem Content="Fixed amount" Tag="fixed" />
                <ComboBoxItem Content="Expected (usual)" Tag="expected" />
                <ComboBoxItem Content="Historical average" Tag="historical_avg" />
            </ComboBox>
            <Button Content="Save recurring" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:Name="MsgText" Opacity="0.8" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
