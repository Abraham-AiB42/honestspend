<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.CreditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="960">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Credit &amp; debts" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Statement &amp; payment · payoff plans · educational score (not a bureau/FICO)" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" />
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Opacity="0.7" Text="Educational credit health" />
                    <TextBlock x:Name="ScoreText" FontSize="40" FontWeight="SemiBold" Text="—" />
                    <TextBlock x:Name="BandText" Opacity="0.8" TextWrapping="Wrap" />
                    <TextBlock x:Name="UtilText" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="DisclaimerText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="BureauNote" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Your credit history (self-entered)" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Bureaus/CK have no consumer API. Enter what you know — model re-scores instantly. Not tax advice; not a FICO." />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox x:Name="OnTimeBox" Header="On-time rate (0–1)" Minimum="0" Maximum="1"
                                   SmallChange="0.01" Value="1" Grid.Row="0" Grid.Column="0" />
                        <NumberBox x:Name="ReportedBox" Header="Your reported Vantage (optional)" Minimum="300" Maximum="850"
                                   PlaceholderText="from CK/app" Grid.Row="0" Grid.Column="1" />
                        <NumberBox x:Name="Late30Box" Header="Late 30 days (12 mo)" Minimum="0" Value="0"
                                   Grid.Row="1" Grid.Column="0" />
                        <NumberBox x:Name="Late60Box" Header="Late 60 days (12 mo)" Minimum="0" Value="0"
                                   Grid.Row="1" Grid.Column="1" />
                        <NumberBox x:Name="Late90Box" Header="Late 90+ days (12 mo)" Minimum="0" Value="0"
                                   Grid.Row="2" Grid.Column="0" />
                        <NumberBox x:Name="HardBox" Header="Hard inquiries (12 mo)" Minimum="0" Value="0"
                                   Grid.Row="2" Grid.Column="1" />
                        <NumberBox x:Name="NewAcctBox" Header="New accounts (12 mo)" Minimum="0" Value="0"
                                   Grid.Row="3" Grid.Column="0" />
                    </Grid>
                    <Button Content="Save history &amp; re-score" Click="SaveHistory_Click" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock x:Name="HistoryMsg" Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Score factors" />
                    <ItemsControl x:Name="FactorList" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Suggestions" Margin="0,8,0,0" />
                    <ItemsControl x:Name="SuggestionList" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="What-if" Margin="0,8,0,0" />
                    <ItemsControl x:Name="WhatIfList" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Payoff plan" />
                    <ComboBox x:Name="StrategyBox" Header="Strategy" SelectedIndex="0" MinWidth="320">
                        <ComboBoxItem Content="Avalanche (highest APR)" Tag="avalanche" />
                        <ComboBoxItem Content="Snowball (smallest balance)" Tag="snowball" />
                        <ComboBoxItem Content="Promo guard" Tag="promo_guard" />
                        <ComboBoxItem Content="Utilization first" Tag="utilization" />
                        <ComboBoxItem Content="Custom rank" Tag="custom" />
                    </ComboBox>
                    <NumberBox x:Name="ExtraBox" Header="Extra $/month after mins" Value="0" Minimum="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Run plan" Click="RunPlan_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Compare strategies" Click="Compare_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PlanSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="OppBanner" Opacity="0.75" TextWrapping="Wrap" />
                    <ItemsControl x:Name="DebtOrder" />
                    <ItemsControl x:Name="InvestVs" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Strategy compare" Margin="0,8,0,0" />
                    <ItemsControl x:Name="CompareList" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Statement &amp; payment" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Close day, due day, what to pay, when cash leaves, and which cash account pays the card. Next payment updates as charges land. Food/gas envelopes live under Budgets — not as a pad on the card payment." />
                    <ItemsControl x:Name="CycleSummaryList" />
                    <ComboBox x:Name="CycleCardBox" Header="Card" HorizontalAlignment="Stretch"
                              PlaceholderText="Pick a card" SelectionChanged="CycleCard_Changed" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox x:Name="CycleCloseDayBox" Header="Close day (1–31)" Minimum="1" Maximum="31"
                                   Value="1" Grid.Row="0" Grid.Column="0" />
                        <NumberBox x:Name="CycleDueDayBox" Header="Due day (1–31)" Minimum="1" Maximum="31"
                                   Value="15" Grid.Row="0" Grid.Column="1" />
                        <ComboBox x:Name="CyclePolicyBox" Header="What to pay" SelectedIndex="2" MinWidth="200"
                                  Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Nothing for now" Tag="none" />
                            <ComboBoxItem Content="Minimum only" Tag="min" />
                            <ComboBoxItem Content="Pay statement in full" Tag="statement" />
                            <ComboBoxItem Content="Pay current balance" Tag="books"
                                          ToolTipService.ToolTip="Full books balance so the statement can open near $0. Includes promo principal." />
                            <ComboBoxItem Content="0% promo monthly set-aside" Tag="promo_sink" />
                            <ComboBoxItem Content="Fixed amount" Tag="fixed" />
                        </ComboBox>
                        <ComboBox x:Name="CycleTimingBox" Header="When cash leaves" SelectedIndex="0" MinWidth="200"
                                  Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="On due day" Tag="on_due" />
                            <ComboBoxItem Content="Day before statement closes" Tag="day_before_close"
                                          ToolTipService.ToolTip="Common for a near-zero statement balance when the bank reports." />
                            <ComboBoxItem Content="On statement close day" Tag="on_close" />
                        </ComboBox>
                        <NumberBox x:Name="CycleFixedBox" Header="Fixed amount ($)" Minimum="0" Value="0"
                                   Grid.Row="2" Grid.Column="0" />
                        <ComboBox x:Name="CycleFundingBox" Header="Pay from (cash)" HorizontalAlignment="Stretch"
                                  PlaceholderText="Checking / cash" Grid.Row="2" Grid.Column="1" />
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CycleProjectedText" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="Projected statement: —" />
                            <TextBlock x:Name="CycleNextPaymentText" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="Next payment: —" />
                            <TextBlock x:Name="CycleDatesText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="CycleWarningsText" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Honesty · utilization · interest" />
                            <TextBlock x:Name="CycleHonestyMinText" Opacity="0.9" TextWrapping="Wrap"
                                       Text="Min payment: —" />
                            <TextBlock x:Name="CycleHonestyInterestText" Opacity="0.9" TextWrapping="Wrap"
                                       Text="Est. monthly interest if min only: —" />
                            <TextBlock x:Name="CycleHonestyUtilText" Opacity="0.9" TextWrapping="Wrap"
                                       Text="Utilization: —" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CyclePayToHardBtn" Content="Set pay to hit 30% util"
                                        Click="CyclePayToHard_Click" />
                                <Button x:Name="CyclePayToSoftBtn" Content="Set pay to hit 10% util"
                                        Click="CyclePayToSoft_Click" />
                            </StackPanel>
                            <TextBlock x:Name="CycleHonestyDisclaimer" Opacity="0.65" FontSize="11" TextWrapping="Wrap"
                                       Text="Educational estimates only. Not a credit score." />
                            <TextBlock FontWeight="SemiBold" Margin="0,4,0,0" Text="How this can affect credit" />
                            <ItemsControl x:Name="CycleAdviceList" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save settings" Click="CycleSave_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Recompute" Click="CycleRecompute_Click" />
                    </StackPanel>
                    <TextBlock x:Name="CycleMsg" Opacity="0.85" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Freeze bank statement"
                               Margin="0,12,0,0" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Record the balance from your actual bank statement for the last close. We compare it to projected so drift is visible." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Name="FreezeActualBox" Header="Actual statement balance ($)" Minimum="0" Value="0"
                                   Width="200" />
                        <Button Content="Freeze last close" Click="FreezeStatement_Click"
                                VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="FreezeMsg" Opacity="0.85" TextWrapping="Wrap" />
                    <ItemsControl x:Name="FreezeHistoryList" />

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Rewards by category"
                               Margin="0,12,0,0" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Which card for this spend? Rates are percent (e.g. gas 5). Still respect Safe to spend." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="RewardsCategoryBox" Header="Category" SelectedIndex="0" MinWidth="160">
                            <ComboBoxItem Content="Gas" Tag="gas" />
                            <ComboBoxItem Content="Groceries" Tag="groceries" />
                            <ComboBoxItem Content="Restaurants" Tag="restaurants" />
                            <ComboBoxItem Content="Amazon" Tag="amazon" />
                            <ComboBoxItem Content="Travel" Tag="travel" />
                            <ComboBoxItem Content="Home improvement" Tag="home_improvement" />
                            <ComboBoxItem Content="General" Tag="general" />
                        </ComboBox>
                        <NumberBox x:Name="RewardsAmountBox" Header="Amount ($)" Minimum="0" Value="40" Width="120" />
                        <Button Content="Best card" Click="RewardsPick_Click" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="RewardsPickMsg" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl x:Name="RewardsPickList" />

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Promo / installment lines"
                               Margin="0,12,0,0" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="0% plans and installments: remaining principal is carved out of statement pay; monthly amount still due this cycle. Pick a plan to edit remaining/monthly, or roll one month." />
                    <ItemsControl x:Name="PromoLineList" />

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Promo payoff calendar"
                               Margin="0,12,0,0" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Month-by-month until each plan is paid off — length is dynamic (not capped at 12). A 24-month Home Depot plan shows 24 rows when remaining ÷ monthly matches." />
                    <TextBlock x:Name="PromoCalendarSummary" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="No open promo plans." />
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PromoCalendarList" />
                    </ScrollViewer>
                    <ComboBox x:Name="PromoEditPickBox" Header="Plan to edit" HorizontalAlignment="Stretch"
                              PlaceholderText="Pick a plan" SelectionChanged="PromoEditPick_Changed" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="PromoNameBox" Header="Plan name" PlaceholderText="Amazon 0% · Apple Card"
                                 Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" />
                        <NumberBox x:Name="PromoRemainingBox" Header="Principal remaining ($)" Minimum="0" Value="0"
                                   Grid.Row="1" Grid.Column="0" />
                        <NumberBox x:Name="PromoMonthlyBox" Header="Monthly payment ($)" Minimum="0" Value="0"
                                   Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add promo line" Click="PromoAdd_Click" />
                        <Button Content="Save plan changes" Click="PromoSave_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Roll one month" Click="PromoRoll_Click"
                                ToolTipService.ToolTip="Reduces remaining by the monthly payment" />
                    </StackPanel>
                    <TextBlock x:Name="PromoMsg" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Autopay (quick)" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Quick policy-only change. For fixed dollar amounts, use Statement &amp; payment above (policy + Fixed amount box)." />
                    <ItemsControl x:Name="AutopayList" />
                    <ComboBox x:Name="AutopayCardBox" Header="Card" HorizontalAlignment="Stretch"
                              PlaceholderText="Pick a card" />
                    <ComboBox x:Name="AutopayPolicyBox" Header="What to pay" SelectedIndex="0" MinWidth="240">
                        <ComboBoxItem Content="Nothing for now" Tag="none" />
                        <ComboBoxItem Content="Minimum only" Tag="min" />
                        <ComboBoxItem Content="Pay statement in full" Tag="statement" />
                        <ComboBoxItem Content="0% promo monthly set-aside" Tag="promo_sink" />
                    </ComboBox>
                    <Button Content="Save autopay" Click="Autopay_Click" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock x:Name="AutopayMsg" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
