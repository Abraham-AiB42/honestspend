<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="960">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Accounts &amp; cards" />
                    <TextBlock Opacity="0.7" Text="Native WinUI · balances, close/due days, next card payment" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add with wizard" Click="Wizard_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Refresh" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <ListView x:Name="AccountList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,8"
                            Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Opacity="0.75" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.6" FontSize="12" Text="{Binding Meta}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Button Content="Edit" Tag="{Binding}" Click="Edit_Click" />
                                    <Button Content="Archive" Tag="{Binding}" Click="Archive_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add account" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="ProfileBox" Header="Entity" MinWidth="200" Grid.Row="0" Grid.Column="0" />
                <ComboBox x:Name="KindBox" Header="Kind" SelectedIndex="0" Grid.Row="0" Grid.Column="1">
                    <ComboBoxItem Content="checking" Tag="checking" />
                    <ComboBoxItem Content="savings" Tag="savings" />
                    <ComboBoxItem Content="credit" Tag="credit" />
                    <ComboBoxItem Content="cash" Tag="cash" />
                    <ComboBoxItem Content="loan" Tag="loan" />
                </ComboBox>

                <TextBox x:Name="NameBox" Header="Nickname" PlaceholderText="Primary checking / Amex" Grid.Row="1" Grid.Column="0" />
                <TextBox x:Name="InstBox" Header="Institution" PlaceholderText="Chase, Amex…" Grid.Row="1" Grid.Column="1" />

                <NumberBox x:Name="BalBox" Header="Balance" Value="0" Grid.Row="2" Grid.Column="0" />
                <NumberBox x:Name="ApyBox" Header="APY (e.g. 0.06)" PlaceholderText="cash yield" Grid.Row="2" Grid.Column="1" />

                <NumberBox x:Name="LimitBox" Header="Credit limit" Grid.Row="3" Grid.Column="0" />
                <NumberBox x:Name="DueBox" Header="Payment due day (1–31)" Maximum="31" Minimum="1" Grid.Row="3" Grid.Column="1" />

                <NumberBox x:Name="PromoAprBox" Header="Promo APR (0 for 0%)" Grid.Row="4" Grid.Column="0" />
                <CalendarDatePicker x:Name="PromoEndBox" Header="Promo end" Grid.Row="4" Grid.Column="1" />
            </Grid>
            <CheckBox x:Name="IfppBox" Content="Count toward Safe to spend" IsChecked="True" />
            <!-- Rewards rates: populated in code when Kind=credit -->
            <StackPanel x:Name="RewardsHost" Visibility="Collapsed" Spacing="0" />
            <Button Content="Save account" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:Name="MsgText" Opacity="0.8" TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
