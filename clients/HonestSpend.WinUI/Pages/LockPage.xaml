<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.LockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Spacing="16" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Unlock HonestSpend" HorizontalAlignment="Center" />
            <TextBlock x:Name="HintText" Opacity="0.8" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Text="Enter your PIN or password, or use Windows Hello." />
            <PasswordBox x:Name="SecretBox" Header="PIN or password" PasswordRevealMode="Peek" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="UnlockBtn" Content="Unlock" Click="Unlock_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="HelloBtn" Content="Windows Hello" Click="Hello_Click" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
