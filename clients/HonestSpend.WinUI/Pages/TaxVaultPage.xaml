<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.TaxVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Tax vault" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Virtual reserve that reduces Safe to spend. Cash stays in your bank — April doesn't ambush checking." />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Opacity="0.7" Text="Reserved (not spendable)" />
                    <TextBlock x:Name="BalanceText" FontSize="36" FontWeight="SemiBold" Text="$0" />
                    <TextBlock x:Name="NoteText" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="EnabledBox" Content="Vault enabled" IsChecked="True" />
            <NumberBox x:Name="BalBox" Header="Vault balance ($)" Minimum="0" Value="0" />
            <NumberBox x:Name="RateBox" Header="Auto set-aside rate (0–1, optional)" Minimum="0" Maximum="1"
                       PlaceholderText="e.g. 0.25 for 25% of variable income" />
            <Button Content="Save vault" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Quick adjust" />
            <NumberBox x:Name="DeltaBox" Header="Delta (+ set aside / − release)" />
            <Button Content="Apply delta" Click="Delta_Click" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Income cliffs" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                Text="Optional haircut on expected/historical income in Safe to spend (bad commission months)." />
            <CheckBox x:Name="CliffOn" Content="Enable income cliffs" />
            <NumberBox x:Name="CliffFactor" Header="Factor (1 = full, 0.5 = half)" Minimum="0" Maximum="1" Value="1" />
            <Button Content="Save cliffs" Click="Cliff_Click" />

            <TextBlock x:Name="MsgText" Opacity="0.85" TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
