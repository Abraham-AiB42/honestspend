<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.PlaybooksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="520">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Move money" />
            <TextBlock Opacity="0.8" TextWrapping="Wrap"
                Text="Between Personal, Business, and Kids — clear labels so Safe to spend stays honest per pile." />

            <ComboBox x:Name="KindBox" Header="What are you doing?" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Business reimburses me" Tag="reimburse" />
                <ComboBoxItem Content="Pay myself (owner distribution)" Tag="distribution" />
                <ComboBoxItem Content="Fund the business (capital inject)" Tag="capital_inject" />
                <ComboBoxItem Content="Kid allowance" Tag="child_allowance" />
            </ComboBox>
            <ComboBox x:Name="FromBox" Header="From account" HorizontalAlignment="Stretch"
                      PlaceholderText="Pick by name" />
            <ComboBox x:Name="ToBox" Header="To account" HorizontalAlignment="Stretch"
                      PlaceholderText="Pick by name" />
            <NumberBox x:Name="AmtBox" Header="Amount ($)" Minimum="0.01" Value="100" />
            <TextBox x:Name="MemoBox" Header="Note (optional)" PlaceholderText="What was this for?" />
            <Button Content="Record transfer" Style="{StaticResource AccentButtonStyle}"
                    Click="Go_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="MsgText" TextWrapping="Wrap" Opacity="0.9" />
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
