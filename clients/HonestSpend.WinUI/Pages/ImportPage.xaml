<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="720">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Import" />
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                    Text="Download CSV from your bank (we never store bank passwords), drop in the inbox or pick a file. Optional bank link lives under More options." />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="How to download from your bank" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="We never store bank logins. Open your bank, export CSV, then import below or drop into the inbox." />
                    <ComboBox x:Name="BankGuideBox" Header="Institution" HorizontalAlignment="Stretch"
                              SelectionChanged="BankGuide_Changed" />
                    <HyperlinkButton x:Name="BankLoginLink" Content="Open bank login" NavigateUri="https://example.com"
                                     Visibility="Collapsed" />
                    <TextBlock x:Name="BankStepsText" Opacity="0.9" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="BankNotesText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Inbox drop folder" />
                    <TextBlock x:Name="InboxPathText" Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Text="…" />
                    <TextBlock x:Name="InboxFilesText" Opacity="0.85" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open inbox folder" Click="OpenInbox_Click" />
                        <Button Content="Import inbox now" Click="ImportInbox_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Refresh" Click="RefreshInbox_Click" />
                    </StackPanel>
                    <CheckBox x:Name="InboxUseSelectedAccountBox"
                              Content="Unmatched files → use Target account below (off = refuse unmatched)"
                              IsChecked="False" />
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Name files with account nicknames (e.g. Primary-checking.csv). Unmatched files are refused unless you opt in above." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Import bank files" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Dump everything you grabbed — 24 months of history, statements, multi-account OFX, CSVs. We map personal vs business, create accounts, and skip duplicates when files overlap." />

                    <!-- Drag-and-drop for any supported type -->
                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2" CornerRadius="12" Padding="28"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop"
                            Tapped="DropZone_Tapped">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="Drop bank files here" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" FontSize="16" />
                            <TextBlock Opacity="0.75" HorizontalAlignment="Center" TextWrapping="Wrap"
                                       Text="CSV · OFX · QFX · PDF · XLSX — one file or many" />
                            <TextBlock x:Name="DropZoneHint" Opacity="0.55" FontSize="12"
                                       HorizontalAlignment="Center" Text="or tap to browse" />
                        </StackPanel>
                    </Border>

                    <ComboBox x:Name="AccountBox" Header="Target account (CSV / single-account files)"
                              HorizontalAlignment="Stretch" />
                    <CheckBox x:Name="AutoCatBox" Content="Auto-categorize after import" IsChecked="True" />
                    <CheckBox x:Name="MultiOfxAutoCreateBox"
                              Content="Multi-account OFX: auto-create missing accounts (match by bank ACCTID when known)"
                              IsChecked="True" />
                    <TextBox x:Name="EndingBalanceBox" Header="Bank ending balance (optional — CSV single-account)"
                             PlaceholderText="From CSV Balance column, or type statement balance"
                             HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Pick file(s)…" Click="PickAny_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Pick CSV…" Click="PickCsv_Click" />
                        <Button Content="Pick OFX/QFX…" Click="PickOfx_Click" />
                        <Button Content="Pick PDF…" Click="PickPdf_Click" />
                    </StackPanel>
                    <TextBlock x:Name="CsvPathText" Opacity="0.85" TextWrapping="Wrap" Text="No file selected" />
                    <ListView x:Name="PendingFilesList" MaxHeight="140" SelectionMode="None" />

                    <!-- Smart mapping: personal vs business + accounts -->
                    <Border x:Name="SmartPlanPanel" Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Smart setup — map your books" />
                            <TextBlock x:Name="SmartPlanSummary" Opacity="0.85" TextWrapping="Wrap" />
                            <TextBlock x:Name="SmartPlanHint" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Who owns this money?" Margin="0,4,0,0" />
                            <StackPanel x:Name="SmartEntitiesPanel" Spacing="8" />
                            <TextBlock FontWeight="SemiBold" Text="Accounts found in your downloads" Margin="0,8,0,0" />
                            <StackPanel x:Name="SmartAccountsPanel" Spacing="8" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <Button Content="Looks good — import everything"
                                        Click="SmartImportCommit_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Re-analyze" Click="SmartImportPlan_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Analyze &amp; map (recommended)" Click="SmartImportPlan_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Preview only" Click="PreviewCsv_Click" />
                        <Button Content="Import without mapping" Click="ImportCsv_Click" />
                        <Button Content="Import PDF statement" Click="ImportPdf_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PreviewText" Opacity="0.85" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ResultText" Opacity="0.9" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel x:Name="NextStepsPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button x:Name="SetBooksFromBankBtn" Content="Set Safe to spend from bank"
                                Click="SetBooksFromBank_Click" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="GoSortBtn" Content="Sort charges" Click="GoSort_Click" Visibility="Collapsed" />
                        <Button x:Name="GoHomeBtn" Content="Home" Click="GoHome_Click" Visibility="Collapsed" />
                    </StackPanel>
                    <Border x:Name="FreezeStatementPanel" Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <InfoBar x:Name="FreezeStatementBar" IsOpen="True" IsClosable="True"
                                     Severity="Informational"
                                     Title="Statement close"
                                     Message="Got a statement balance from the bank? Freeze it for this close." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="FreezeActualBox" Header="Actual statement balance ($)"
                                           Minimum="0" Value="0" Width="220" />
                                <Button Content="Freeze" Click="FreezeStatement_Click"
                                        VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Not now" Click="DismissFreeze_Click" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock x:Name="FreezeMsg" Opacity="0.85" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Best: CSV or OFX/QFX. Ending balance → Match bank. One-tap Set Safe to spend from bank when bank bal differs." />
                </StackPanel>
            </Border>

            <Expander Header="More options (xlsx, amount sign, bank link)" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16" Margin="0,12,0,0">
                    <ComboBox x:Name="SignBox" Header="Amount sign" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Bank style (expenses negative)" Tag="bank" />
                        <ComboBoxItem Content="Invert signs" Tag="invert" />
                    </ComboBox>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Legacy Budget.xlsx" />
                            <ComboBox x:Name="ProfileSlugBox" Header="Who" SelectedIndex="0" HorizontalAlignment="Stretch" />
                            <CheckBox x:Name="DryRunBox" Content="Dry run (scan only)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Pick xlsx…" Click="PickXlsx_Click" Style="{StaticResource AccentButtonStyle}" />
                                <TextBlock x:Name="XlsxPathText" VerticalAlignment="Center" Opacity="0.75" Text="No file" />
                            </StackPanel>
                            <Button Content="Import xlsx" Click="ImportXlsx_Click" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Optional bank link" />
                            <TextBlock x:Name="PlaidText" Opacity="0.8" TextWrapping="Wrap" Text="Checking…" />
                            <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                                Text="Full connect / sync is under Banks in Full books. This is status only." />
                            <Button Content="Refresh bank-link status" Click="Plaid_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <InfoBar x:Name="SuccessBar" IsClosable="True" IsOpen="False" Severity="Success" />
            <InfoBar x:Name="WarningBar" IsClosable="True" IsOpen="False" Severity="Warning" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
