<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
    <ScrollViewer x:Name="PageScroller" Padding="24">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Import bank files" />
                <TextBlock Opacity="0.85" TextWrapping="Wrap"
                    Text="Drop transaction downloads, monthly statements, or both — a folder of statements is fine. We match the same account across files (bank + last 4), skip duplicates, and take every forecast fact we can: New Balance, due date, APR, credit limit, and promos. More files = sharper Safe to spend. We never store bank passwords." />
            </StackPanel>

            <!-- Primary: drag-and-drop first paint -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2" CornerRadius="12" Padding="36"
                            DragOver="DropZone_DragOver"
                            Drop="DropZone_Drop"
                            Tapped="DropZone_Tapped"
                            MinHeight="160">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Drop transactions and/or statements" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" FontSize="18" />
                            <TextBlock Opacity="0.8" HorizontalAlignment="Center" TextWrapping="Wrap"
                                       Text="CSV · OFX · QFX · QIF · PDF statements · XLSX — files or a whole folder" />
                            <TextBlock x:Name="DropZoneHint" Opacity="0.65" FontSize="12"
                                       HorizontalAlignment="Center" Text="or tap to browse · Pick folder for Statements" />
                        </StackPanel>
                    </Border>

                    <DropDownButton Content="Pick file(s) / folder" Style="{StaticResource AccentButtonStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Pick file(s)…" Click="PickAny_Click" />
                                <MenuFlyoutItem Text="Pick folder…" Click="PickFolder_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock x:Name="CsvPathText" Opacity="0.85" TextWrapping="Wrap" Text="No file selected" />
                    <ListView x:Name="PendingFilesList" MaxHeight="140" SelectionMode="None" />

                    <!-- Smart mapping: personal vs business + accounts -->
                    <Border x:Name="SmartPlanPanel" Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="We read your files — confirm once" />
                            <TextBlock x:Name="SmartPlanSummary" Opacity="0.9" TextWrapping="Wrap" />
                            <TextBlock x:Name="SmartPlanHint" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="SmartEntitiesHeader" FontWeight="SemiBold"
                                       Text="Who owns this money? (only change if wrong)" Margin="0,8,0,0" />
                            <StackPanel x:Name="SmartEntitiesPanel" Spacing="8" />
                            <Button x:Name="AddBusinessBtn" Content="Add a business"
                                    Click="AddBusiness_Click" HorizontalAlignment="Left" />
                            <TextBlock FontWeight="SemiBold" Text="What we found in each file" Margin="0,8,0,0" />
                            <TextBlock Opacity="0.85" FontSize="13" TextWrapping="Wrap"
                                Text="Each card is one account. Tap Merge on the one to fold in — it stays on the right. Scroll to the matching account and tap Merge here." />
                            <TextBlock Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                                Text="Transaction lists are often newer than the statement. We match the statement’s first few date + amount line items inside the list — extra recent charges on the list are expected." />
                            <StackPanel x:Name="SmartAccountsPanel" Spacing="10" />
                            <Button x:Name="AddMoreFilesBtn" Content="Add more files…"
                                    Click="AddMoreFiles_Click" HorizontalAlignment="Left"
                                    Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="Looks good — import everything"
                                        Click="SmartImportCommit_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="ImportThenMoreBtn" Content="Import these + attach more"
                                        Click="SmartImportThenMore_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="AnalyzeBusyPanel" Visibility="Collapsed" Orientation="Horizontal"
                                Spacing="12" Margin="0,4,0,0">
                        <ProgressRing x:Name="AnalyzeBusyRing" Width="28" Height="28" IsActive="False" />
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="AnalyzeBusyTitle" FontWeight="SemiBold" Text="Analyzing files…" />
                            <TextBlock x:Name="AnalyzeBusyDetail" Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                                       Text="Reading downloads and matching statements to transaction lists. Lists may include newer charges than the statement — that’s expected." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PreMapActions" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AnalyzeMapBtn" Content="Analyze &amp; map (recommended)" Click="SmartImportPlan_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="PreviewOnlyBtn" Content="Preview only" Click="PreviewCsv_Click" />
                        <Button x:Name="ImportWithoutMapBtn" Content="Import without mapping" Click="ImportCsv_Click" />
                        <Button x:Name="ImportPdfBtn" Content="Import PDF statement" Click="ImportPdf_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PreviewText" Opacity="0.85" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ResultText" Opacity="0.9" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel x:Name="NextStepsPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button x:Name="SetBooksFromBankBtn" Content="Set Safe to spend from bank"
                                Click="SetBooksFromBank_Click" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="GoSortBtn" Content="Sort charges" Click="GoSort_Click" Visibility="Collapsed" />
                        <Button x:Name="GoHomeBtn" Content="Home" Click="GoHome_Click" Visibility="Collapsed" />
                    </StackPanel>
                    <Border x:Name="FreezeStatementPanel" Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <InfoBar x:Name="FreezeStatementBar" IsOpen="True" IsClosable="True"
                                     Severity="Informational"
                                     Title="Statement close"
                                     Message="Got a statement balance from the bank? Freeze it for this close." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="FreezeActualBox" Header="Actual statement balance ($)"
                                           Minimum="0" Value="0" Width="220" />
                                <Button Content="Freeze" Click="FreezeStatement_Click"
                                        VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Not now" Click="DismissFreeze_Click" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock x:Name="FreezeMsg" Opacity="0.85" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="PromosFoundPanel" Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Promos found" />
                            <TextBlock x:Name="PromosFoundText" Opacity="0.9" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                            <Button x:Name="ReviewPromoConflictsBtn" Content="Review conflicts"
                                    Click="ReviewPromoConflicts_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel x:Name="AdvancedImportOptions" Spacing="20">
            <Expander Header="Target account &amp; options" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <ComboBox x:Name="AccountBox" Header="Target account (CSV / single-account files)"
                              HorizontalAlignment="Stretch" />
                    <CheckBox x:Name="AutoCatBox" Content="Auto-categorize after import" IsChecked="True" />
                    <CheckBox x:Name="MultiOfxAutoCreateBox"
                              Content="Multi-account OFX: auto-create missing accounts (match by bank ACCTID when known)"
                              IsChecked="True" />
                    <TextBox x:Name="EndingBalanceBox" Header="Bank ending balance (optional — CSV single-account)"
                             PlaceholderText="From CSV Balance column, or type statement balance"
                             HorizontalAlignment="Stretch" />
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Best: CSV or OFX/QFX. Ending balance → Match bank. One-tap Set Safe to spend from bank when bank bal differs." />
                </StackPanel>
            </Expander>

            <Expander Header="How to download from your bank" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10" Margin="0,12,0,0">
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="We never store bank logins. Open your bank, export CSV/OFX, then drop the files above." />
                    <ComboBox x:Name="BankGuideBox" Header="Institution" HorizontalAlignment="Stretch"
                              SelectionChanged="BankGuide_Changed" />
                    <HyperlinkButton x:Name="BankLoginLink" Content="Open bank login" NavigateUri="https://example.com"
                                     Visibility="Collapsed" />
                    <TextBlock x:Name="BankStepsText" Opacity="0.9" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="BankNotesText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <Expander Header="Inbox drop folder" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10" Margin="0,12,0,0">
                    <TextBlock x:Name="InboxPathText" Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Text="…" />
                    <TextBlock x:Name="InboxFilesText" Opacity="0.85" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open inbox folder" Click="OpenInbox_Click" />
                        <Button Content="Import inbox now" Click="ImportInbox_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Refresh" Click="RefreshInbox_Click" />
                    </StackPanel>
                    <CheckBox x:Name="InboxUseSelectedAccountBox"
                              Content="Unmatched files → use Target account below (off = refuse unmatched)"
                              IsChecked="False" />
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Name files with account nicknames (e.g. Primary-checking.csv). Unmatched files are refused unless you opt in above." />
                </StackPanel>
            </Expander>

            <Expander Header="More options (xlsx, amount sign, bank link)" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16" Margin="0,12,0,0">
                    <ComboBox x:Name="SignBox" Header="Amount sign" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Bank style (expenses negative)" Tag="bank" />
                        <ComboBoxItem Content="Invert signs" Tag="invert" />
                    </ComboBox>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Legacy Budget.xlsx" />
                            <ComboBox x:Name="ProfileSlugBox" Header="Who" SelectedIndex="0" HorizontalAlignment="Stretch" />
                            <CheckBox x:Name="DryRunBox" Content="Dry run (scan only)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Pick xlsx…" Click="PickXlsx_Click" Style="{StaticResource AccentButtonStyle}" />
                                <TextBlock x:Name="XlsxPathText" VerticalAlignment="Center" Opacity="0.75" Text="No file" />
                            </StackPanel>
                            <Button Content="Import xlsx" Click="ImportXlsx_Click" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Optional bank link" />
                            <TextBlock x:Name="PlaidText" Opacity="0.8" TextWrapping="Wrap" Text="Checking…" />
                            <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                                Text="Full connect / sync is under Banks in Full books. This is status only." />
                            <Button Content="Refresh bank-link status" Click="Plaid_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
            </StackPanel>

            <InfoBar x:Name="SuccessBar" IsClosable="True" IsOpen="False" Severity="Success" />
            <InfoBar x:Name="WarningBar" IsClosable="True" IsOpen="False" Severity="Warning" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
    <Border x:Name="MergeDock"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Width="380"
            MaxHeight="720"
            Margin="0,72,24,24"
            Visibility="Collapsed"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="12"
            Padding="12">
        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="This card popped out" />
            <TextBlock x:Name="MergeDockHint" Opacity="0.8" FontSize="12" TextWrapping="Wrap"
                       Text="Scroll to the matching account and tap Merge here on that card. Cancel puts this one back." />
            <Button Content="Cancel" Click="CancelMerge_Click" HorizontalAlignment="Left" />
            <Border x:Name="MergeDockCardHost" />
        </StackPanel>
    </Border>
    </Grid>
</Page>
