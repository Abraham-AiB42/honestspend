<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.BuyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Can I buy this?" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Picks the smartest safe account from float, rewards, and promo terms. Uses Who / money view from the top bar." />

            <NumberBox x:Name="AmountBox" Header="Amount ($)" Minimum="0.01"
                       SpinButtonPlacementMode="Inline" Value="100" />
            <ComboBox x:Name="ProposedAccountBox" Header="Proposed account"
                      PlaceholderText="Cash or card"
                      HorizontalAlignment="Stretch" />
            <ComboBox x:Name="RewardCategoryBox" Header="Reward category" SelectedIndex="0"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Everything else" Tag="general" IsSelected="True" />
                <ComboBoxItem Content="Gas" Tag="gas" />
                <ComboBoxItem Content="Groceries" Tag="groceries" />
                <ComboBoxItem Content="Restaurants" Tag="restaurants" />
                <ComboBoxItem Content="Travel" Tag="travel" />
                <ComboBoxItem Content="Amazon" Tag="amazon" />
                <ComboBoxItem Content="Online" Tag="online" />
                <ComboBoxItem Content="Drugstore" Tag="drugstore" />
                <ComboBoxItem Content="Home improvement" Tag="home_improvement" />
                <ComboBoxItem Content="Entertainment" Tag="entertainment" />
                <ComboBoxItem Content="Utilities" Tag="utilities" />
                <ComboBoxItem Content="Other" Tag="other" />
            </ComboBox>
            <ComboBox x:Name="PromoBox" Header="Promo (optional)" SelectedIndex="0"
                      HorizontalAlignment="Stretch" SelectionChanged="Promo_SelectionChanged">
                <ComboBoxItem Content="None" Tag="none" IsSelected="True" />
                <ComboBoxItem Content="This card's intro 0%" Tag="card_intro" />
                <ComboBoxItem Content="Purchase plan (months / monthly)" Tag="purchase_plan" />
                <ComboBoxItem Content="Buy now, pay later (Klarna, Affirm, Afterpay…)" Tag="bnpl" />
                <ComboBoxItem Content="I have a new offer" Tag="new_offer" />
            </ComboBox>
            <StackPanel x:Name="PlanPanel" Spacing="8" Visibility="Collapsed">
                <NumberBox x:Name="PlanMonthsBox" Header="Plan months" Minimum="1" Maximum="60"
                           SpinButtonPlacementMode="Compact" PlaceholderText="Optional" />
                <NumberBox x:Name="PlanMonthlyBox" Header="Monthly ($)" Minimum="0"
                           SpinButtonPlacementMode="Compact" PlaceholderText="Optional" />
            </StackPanel>
            <StackPanel x:Name="BnplPanel" Spacing="8" Visibility="Collapsed">
                <ComboBox x:Name="BnplProviderBox" Header="Provider" SelectedIndex="0"
                          HorizontalAlignment="Stretch" SelectionChanged="BnplProvider_SelectionChanged">
                    <ComboBoxItem Content="Klarna" Tag="klarna" IsSelected="True" />
                    <ComboBoxItem Content="Afterpay" Tag="afterpay" />
                    <ComboBoxItem Content="Affirm" Tag="affirm" />
                    <ComboBoxItem Content="PayPal Pay in 4" Tag="paypal_pay_in_4" />
                    <ComboBoxItem Content="Zip" Tag="zip" />
                    <ComboBoxItem Content="Sezzle" Tag="sezzle" />
                </ComboBox>
                <ComboBox x:Name="BnplPlanBox" Header="Plan" SelectedIndex="0"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Pay in 4 (every 2 weeks)" Tag="pay_in_4" IsSelected="True" />
                    <ComboBoxItem Content="Monthly installments" Tag="monthly" />
                </ComboBox>
                <NumberBox x:Name="BnplPaymentsBox" Header="Payments (monthly plans)" Minimum="2" Maximum="36"
                           SpinButtonPlacementMode="Compact" Value="12" />
                <NumberBox x:Name="BnplAprBox" Header="APR % (from checkout)" Minimum="0" Maximum="40"
                           SpinButtonPlacementMode="Compact" Value="0" />
                <NumberBox x:Name="BnplOrigBox" Header="Origination / checkout fee ($)" Minimum="0"
                           SpinButtonPlacementMode="Compact" Value="0" />
                <NumberBox x:Name="BnplServiceBox" Header="Service fee ($)" Minimum="0"
                           SpinButtonPlacementMode="Compact" Value="0" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap"
                    Text="Fees you enter are split into the installments. Typical late fees are shown in the result and are not added unless you miss a payment." />
            </StackPanel>
            <ComboBox x:Name="CategoryBox" Header="Budget category (optional)" MaxDropDownHeight="320"
                      PlaceholderText="Any / uncategorized"
                      HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckBtn" Content="Check purchase" Click="Check_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="SimBtn" Content="What if I buy it?" Click="Simulate_Click" />
                <Button x:Name="ScenarioBtn" Content="Save as scenario" Click="SaveScenario_Click" />
            </StackPanel>
            <StackPanel x:Name="CommitPanel" Spacing="8" Visibility="Collapsed">
                <Button x:Name="CommitRecBtn" Content="I charged the recommended account"
                        Click="CommitRec_Click" HorizontalAlignment="Left" />
                <Button x:Name="CommitOrigBtn" Content="I charged my original pick"
                        Click="CommitOrig_Click" HorizontalAlignment="Left" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="ScenarioMsg" Opacity="0.85" TextWrapping="Wrap" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="VerdictText" FontSize="24" FontWeight="SemiBold" Text="—" />
                    <TextBlock x:Name="RecText" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReasonText" Opacity="0.85" TextWrapping="Wrap" />
                    <TextBlock x:Name="BudgetCheckText" Opacity="0.85" TextWrapping="Wrap" />
                    <StackPanel x:Name="RaidPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock x:Name="RaidText" Opacity="0.9" TextWrapping="Wrap" />
                        <Button x:Name="RaidBtn" Content="Raid envelope &amp; re-check"
                                Click="Raid_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Options" Margin="0,8,0,0" />
                    <ItemsControl x:Name="OptionsList" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Free cash from budgets" Margin="0,8,0,0" />
                    <StackPanel x:Name="CutPanel" Spacing="6" />
                    <TextBlock x:Name="ScopeText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="SimText" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="NoticeBar" IsClosable="True" IsOpen="False" Severity="Informational" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>
