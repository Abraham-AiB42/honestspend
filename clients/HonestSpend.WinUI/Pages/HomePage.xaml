<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Home" />
                    <TextBlock x:Name="StatusText" Opacity="0.7" Text="Connecting…" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Refresh" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <!-- Feedback near top — open-rarely (visible after one-tap actions) -->
            <InfoBar x:Name="SuccessBar" IsOpen="False" Severity="Success" IsClosable="True" />
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
            <InfoBar x:Name="EngineBar" IsOpen="False" Severity="Warning" IsClosable="True"
                     Title="Engine offline" Message="Start the local money engine (one click).">
                <InfoBar.ActionButton>
                    <Button Content="Start engine" Click="StartEngine_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="SetupBar" IsOpen="False" Severity="Informational" IsClosable="True"
                     Title="Almost there" Message="Add checking so we can show Safe to spend.">
                <InfoBar.ActionButton>
                    <Button Content="2-minute setup" Click="Setup_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="EmptyBillBar" IsOpen="False" Severity="Informational" IsClosable="True"
                     Title="Tip" Message="Add rent or a paycheck so Safe to spend knows what’s coming.">
                <InfoBar.ActionButton>
                    <Button Content="Add bill" Click="EmptyBill_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="BankTipBar" IsOpen="False" Severity="Informational" IsClosable="True"
                     Title="Less typing later" Message="Link a bank or drop a CSV when you’re ready — optional.">
                <InfoBar.ActionButton>
                    <Button Content="Link bank" Click="BankTip_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- SIMPLE: Safe to spend + do this next -->
            <StackPanel x:Name="SimplePanel" Spacing="14">
                <!-- License soft gate (Store / commercial only) -->
                <InfoBar x:Name="LicenseBar" IsOpen="False" Severity="Warning"
                         IsClosable="False" Title="License">
                    <InfoBar.ActionButton>
                        <Button Content="Activate / restore" Click="LicenseBar_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="BudgetSeedBar" IsOpen="False" Severity="Informational"
                         IsClosable="True" Title="Budgets">
                    <InfoBar.ActionButton>
                        <Button Content="Seed from history" Click="BudgetSeed_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="CardFixBar" IsOpen="False" Severity="Informational"
                         IsClosable="True" Title="Card payments need a quick setup"
                         Message="Due day, pay-from cash, and what to pay — about 60 seconds.">
                    <InfoBar.ActionButton>
                        <Button Content="Fix card payments" Click="CardFixOpen_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border x:Name="CardFixPanel" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" FontSize="18" Text="Fix card payments" />
                        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                            Text="Tell us when the bill is due, which cash pays it, and what to pay. Safe to spend updates after you save." />
                        <ComboBox x:Name="CardFixCardBox" Header="Credit card" HorizontalAlignment="Stretch"
                                  PlaceholderText="Pick a card" SelectionChanged="CardFixCard_Changed" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <NumberBox x:Name="CardFixDueDayBox" Header="Due day (1–31)" Minimum="1" Maximum="31"
                                       Value="15" Grid.Row="0" Grid.Column="0" />
                            <NumberBox x:Name="CardFixCloseDayBox" Header="Close day (1–31)" Minimum="1" Maximum="31"
                                       Value="1" Grid.Row="0" Grid.Column="1" />
                            <ComboBox x:Name="CardFixFundingBox" Header="Pay from" HorizontalAlignment="Stretch"
                                      PlaceholderText="Checking / cash" Grid.Row="1" Grid.Column="0"
                                      Grid.ColumnSpan="2" />
                            <ComboBox x:Name="CardFixPolicyBox" Header="What to pay" SelectedIndex="1" MinWidth="200"
                                      Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch"
                                      SelectionChanged="CardFixPolicy_Changed">
                                <ComboBoxItem Content="Minimum only" Tag="min" />
                                <ComboBoxItem Content="Pay statement in full" Tag="statement" />
                                <ComboBoxItem Content="Pay current balance" Tag="books"
                                              ToolTipService.ToolTip="Full books balance so the statement can open near $0." />
                                <ComboBoxItem Content="Fixed amount" Tag="fixed" />
                            </ComboBox>
                            <ComboBox x:Name="CardFixTimingBox" Header="When cash leaves" SelectedIndex="0" MinWidth="200"
                                      Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="On due day" Tag="on_due" />
                                <ComboBoxItem Content="Day before statement closes" Tag="day_before_close" />
                                <ComboBoxItem Content="On statement close day" Tag="on_close" />
                            </ComboBox>
                            <NumberBox x:Name="CardFixFixedBox" Header="Fixed amount ($)" Minimum="0" Value="0"
                                       Grid.Row="3" Grid.Column="0" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                                    Click="CardFixSave_Click" MinWidth="100" />
                            <Button Content="Close" Click="CardFixClose_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CardFixMsg" Opacity="0.85" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="6">
                        <TextBlock Opacity="0.7" FontSize="13" Text="Safe to spend" />
                        <TextBlock x:Name="SafeText" FontSize="48" FontWeight="SemiBold"
                                   Margin="0,4,0,0" Text="—" />
                        <TextBlock x:Name="SafeUntilLine" Opacity="0.75" FontSize="14" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,2,0,0" />
                        <TextBlock x:Name="FloatWhisper" Opacity="0.7" FontSize="14" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="CardPayWhisper" Opacity="0.7" FontSize="14" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="StatusLine" FontSize="16" FontWeight="SemiBold" Text="—" />
                        <TextBlock x:Name="RiskLine" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="PendingLine" Opacity="0.75" TextWrapping="Wrap" Foreground="Orange" />
                        <TextBlock x:Name="WhoLine" Opacity="0.55" FontSize="12" Margin="0,4,0,0" />
                        <Expander x:Name="WhyExpander" Header="Why this number?" Margin="0,8,0,0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="WhyOneLiner" Opacity="0.7" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="BudgetReserveLine" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                    Text="After bills, buffer, tax vault, and remaining budgets" />
                                <ItemsControl x:Name="WhyList" Margin="0,4,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border x:Name="ComingUpCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Coming up" FontWeight="SemiBold" />
                        <TextBlock x:Name="ComingUpSubtitle" Opacity="0.7" TextWrapping="Wrap" />
                        <ItemsControl x:Name="ComingUpList" />
                        <TextBlock x:Name="ComingUpEmpty" Opacity="0.65" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="ComingUpTotals" Opacity="0.7" FontSize="12" />
                        <HyperlinkButton x:Name="ComingUpShowAllBtn"
                                         Visibility="Collapsed"
                                         Padding="0"
                                         FontSize="12"
                                         Click="ComingUpShowAll_Click" />
                        <StackPanel x:Name="ComingUpPayPanel" Orientation="Horizontal" Spacing="8"
                                    Visibility="Collapsed">
                            <ComboBox x:Name="ComingUpPayPick" MinWidth="220" MaxWidth="420"
                                      PlaceholderText="Expense to mark paid" />
                            <Button x:Name="ComingUpMarkPaidBtn" Content="I paid this"
                                    Click="ComingUpMarkPaid_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="BudgetCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="Budgets this period" />
                        <TextBlock x:Name="BudgetScopeNote" Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <ItemsControl x:Name="BudgetSummaryList" />
                        <TextBlock Opacity="0.65" FontSize="12" Text="Free cash (tap to apply)"
                                   Margin="0,4,0,0" />
                        <StackPanel x:Name="BudgetCutPanel" Spacing="6" />
                        <Button Content="Manage budgets" HorizontalAlignment="Left" Click="BudgetsManage_Click" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Opacity="0.7" FontSize="13" Text="Do this next" />
                        <TextBlock x:Name="NextTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Text="—" />
                        <TextBlock x:Name="NextReason" Opacity="0.85" TextWrapping="Wrap" />
                        <TextBlock x:Name="NextDisclaimer" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                        <Button x:Name="NextBtn" Content="Continue" Style="{StaticResource AccentButtonStyle}"
                                Click="DoNext_Click" HorizontalAlignment="Left" MinWidth="140" />
                        <TextBlock Opacity="0.65" FontSize="12" Text="Other options" Margin="0,8,0,0" />
                        <ItemsControl x:Name="AltList" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="Up next" />
                        <ItemsControl x:Name="AlertList" />
                    </StackPanel>
                </Border>

                <Border x:Name="BooksCard" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="After import / bank" />
                        <TextBlock x:Name="BooksTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="BooksReason" Opacity="0.85" TextWrapping="Wrap" />
                        <ItemsControl x:Name="BooksSamples" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BooksBtn" Content="Continue" HorizontalAlignment="Left"
                                    Click="Books_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="BooksSecondaryBtn" Content="Sort charges" HorizontalAlignment="Left"
                                    Click="BooksSecondary_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="FeeCard" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="Fee check" />
                        <TextBlock x:Name="FeeTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="FeeReason" Opacity="0.85" TextWrapping="Wrap" />
                        <TextBlock x:Name="FeeItemLabel" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Yes, a fee" Click="FeeConfirm_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Not a fee" Click="FeeDismiss_Click" />
                            <Button Content="Skip" Click="FeeSkip_Click" />
                        </StackPanel>
                        <TextBlock x:Name="FeeMsg" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border x:Name="RecurringCard" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="Possible bills" />
                        <TextBlock x:Name="RecurringTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="RecurringReason" Opacity="0.85" TextWrapping="Wrap" />
                        <TextBlock x:Name="RecurringItemLabel" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add this bill" Click="RecurringAccept_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Skip" Click="RecurringSkip_Click" />
                            <Button Content="Add manually" Click="Recurring_Click" />
                        </StackPanel>
                        <TextBlock x:Name="RecurringMsg" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border x:Name="PromoCard" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="0% promo" />
                        <TextBlock x:Name="PromoTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PromoReason" Opacity="0.85" TextWrapping="Wrap" />
                        <Button x:Name="PromoBtn" Content="Create set-aside" HorizontalAlignment="Left"
                                Click="Promo_Click" Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:Name="PromoMsg" Opacity="0.85" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="MonthCloseCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="Close the month" />
                        <TextBlock x:Name="MonthCloseSubtitle" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock x:Name="MonthCloseProgress" FontWeight="SemiBold" />
                        <ItemsControl x:Name="MonthCloseList" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="MonthCloseBtn" Content="Do next close step" HorizontalAlignment="Left"
                                    Click="MonthClose_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="MarkMonthClosedBtn" Content="Mark month closed" HorizontalAlignment="Left"
                                    Click="MarkMonthClosed_Click" Visibility="Collapsed"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="TaxYearCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="Tax year prep" />
                        <TextBlock x:Name="TaxYearTitle" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock x:Name="TaxYearSubtitle" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock x:Name="TaxYearProgress" FontWeight="SemiBold" />
                        <ItemsControl x:Name="TaxYearList" />
                        <Button x:Name="TaxYearBtn" Content="Do next tax step" HorizontalAlignment="Left"
                                Click="TaxYear_Click" Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                            Text="Prep for TurboTax/CPA — not e-file. Educational only." />
                    </StackPanel>
                </Border>

                <Border x:Name="RitualCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="3-minute check" />
                        <TextBlock x:Name="RitualSubtitle" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock x:Name="RitualProgress" FontWeight="SemiBold" />
                        <ItemsControl x:Name="RitualList" />
                        <Button x:Name="RitualNextBtn" Content="Do next open item" HorizontalAlignment="Left"
                                Click="RitualNext_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="WealthCard" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Opacity="0.7" Text="Grow wealth (basics only)" />
                        <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                            Text="After you're safe — educational, not investment advice." />
                        <ItemsControl x:Name="WealthList" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add something" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Can I buy?" Click="Buy_Click" />
                    <Button Content="Done for now" Click="Done_Click" />
                </StackPanel>
                <TextBlock x:Name="DoneText" Opacity="0.75" />
                <StackPanel x:Name="PowerToolsPanel" Orientation="Horizontal" Spacing="8">
                    <Button Content="Rescue options" Click="Rescue_Click" />
                    <Button Content="Money brief" Click="Brief_Click" />
                </StackPanel>
                <TextBlock x:Name="BriefText" TextWrapping="Wrap" Opacity="0.9" IsTextSelectionEnabled="True" />
                <ItemsControl x:Name="RescueList" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
