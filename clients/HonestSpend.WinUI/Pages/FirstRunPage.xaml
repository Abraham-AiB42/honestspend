<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel x:Name="WizardBody" Spacing="14" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Get started" />
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="6" />
            <TextBlock x:Name="EngineChip" Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                       Text="Starting the money engine in the background…" />
            <TextBlock x:Name="StepLabel" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="QuestionText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="HintText" Opacity="0.8" TextWrapping="Wrap" />

            <StackPanel x:Name="Fields" Spacing="12" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackBtn" Content="Back" Click="Back_Click" />
                <Button x:Name="NextBtn" Content="Next" Style="{StaticResource AccentButtonStyle}" Click="Next_Click" />
                <Button x:Name="SkipBtn" Content="Skip this step" Click="Skip_Click" />
            </StackPanel>
            <TextBlock x:Name="MsgText" TextWrapping="Wrap" Opacity="0.9" />
            <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
            <InfoBar x:Name="InfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
