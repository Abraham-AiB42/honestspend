<?xml version="1.0" encoding="utf-8"?>
<!--
  HonestSpend MSIX package identity (Desktop Bridge / full-trust WinUI).

  Before Store or permanent sideload:
    1. Partner Center → Product identity → copy Package/Identity Name + Publisher
    2. Replace Name + Publisher below (Publisher must match your signing cert CN)
    3. Bump Version with each submission (Windows versioning: Major.Minor.Build.Revision)

  Scaffold defaults are for local sideload with a self-signed cert
  (see scripts/package-msix.ps1 -CreateSelfSignedCert).
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10" xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10" IgnorableNamespaces="uap uap10 rescap desktop build" xmlns:build="http://schemas.microsoft.com/developer/appx/2015/build">
  <!--
    THIS PACKAGE MANIFEST FILE IS GENERATED BY THE BUILD PROCESS.

    Changes to this file will be lost when it is regenerated. To correct errors in this file, edit the source .appxmanifest file.

    For more information on package manifest files, see http://go.microsoft.com/fwlink/?LinkID=241727
  -->
  <Identity Name="HonestSpend.HonestSpend" Publisher="CN=HonestSpend Dev" Version="1.0.31.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>HonestSpend</DisplayName>
    <PublisherDisplayName>HonestSpend</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Local-first liquidity OS — Safe to spend, import bank files, open rarely.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="EN-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="HonestSpend.WinUI.exe" EntryPoint="Windows.FullTrustApplication" uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="HonestSpend" Description="Local-first liquidity OS — Safe to spend you can trust." BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <!-- Optional: start minimized / tray via StartupTask later -->
    </Application>
  </Applications>
  <Capabilities>
    <!-- Full trust: spawn local Python engine, tray, user data under %USERPROFILE%\.financial-os -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
  <build:Metadata>
    <build:Item Name="XamlCompiler.exe" Version="3.0.0.2607" />
    <build:Item Name="makepri.exe" Version="10.0.28000.2526 (WinBuild.160101.0800)" />
  </build:Metadata>
</Package>