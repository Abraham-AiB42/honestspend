<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.MoneyWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="14" MaxWidth="520">
            <TextBlock x:ConnectionId='2' x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Wizard" />
            <TextBlock x:ConnectionId='3' x:Name="StepText" Opacity="0.7" />
            <TextBlock x:ConnectionId='4' x:Name="QuestionText" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:ConnectionId='5' x:Name="HintText" Opacity="0.75" TextWrapping="Wrap" />

            <StackPanel x:ConnectionId='6' x:Name="FieldsPanel" Spacing="12" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:ConnectionId='9' x:Name="BackBtn" Content="Back"                    />
                <Button x:ConnectionId='10' x:Name="NextBtn" Content="Next" Style="{StaticResource AccentButtonStyle}"                    />
                <Button x:ConnectionId='11' Content="Cancel"                      />
            </StackPanel>
            <TextBlock x:ConnectionId='7' x:Name="MsgText" TextWrapping="Wrap" Opacity="0.85" />
            <InfoBar x:ConnectionId='8' x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>

