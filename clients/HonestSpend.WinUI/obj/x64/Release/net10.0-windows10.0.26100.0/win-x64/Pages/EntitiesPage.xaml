<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.EntitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Entities" />
            <TextBlock Opacity="0.8" TextWrapping="Wrap"
                Text="Personal is always available. Add Business(es) for company books and Child(ren) for siloed allowance tracking. Each entity has its own Spendable by default." />

            <InfoBar x:ConnectionId='2' x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
            <TextBlock x:ConnectionId='3' x:Name="StatusText" Opacity="0.75" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Your entities" />
                    <ListView x:ConnectionId='10' x:Name="EntityList" SelectionMode="None" />
                    <Button x:ConnectionId='11' Content="Refresh"                       />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add Business" />
                    <TextBox x:ConnectionId='7' x:Name="BizNameBox" Header="Display name" PlaceholderText="e.g. Northwind LLC" />
                    <ComboBox x:ConnectionId='8' x:Name="BizTaxBox" Header="Primary tax form" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="1120-S (S-corp)" Tag="1120S" />
                        <ComboBoxItem Content="1065 (Partnership)" Tag="1065" />
                        <ComboBoxItem Content="Schedule C (sole prop)" Tag="SchC" />
                        <ComboBoxItem Content="Other / none" Tag="other" />
                    </ComboBox>
                    <Button x:ConnectionId='9' Content="Add Business" Style="{StaticResource AccentButtonStyle}"                      />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add Child" />
                    <TextBox x:ConnectionId='5' x:Name="ChildNameBox" Header="Display name" PlaceholderText="e.g. first name" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Child entities use a simple allowance COA (not tax filing). Linked to Personal by default for household context." />
                    <Button x:ConnectionId='6' Content="Add Child" Style="{StaticResource AccentButtonStyle}"                        />
                </StackPanel>
            </Border>

            <TextBlock x:ConnectionId='4' x:Name="MsgText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

