<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.PlaidPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="760">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Bank connect (optional BYOK Plaid)" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Free core path: Import CSV/OFX. Plaid is optional with your own keys (we never bill). Link opens in the browser." />
                </StackPanel>
                <Button x:ConnectionId='17' Grid.Column="1" Content="Refresh"                       />
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Status" />
                    <TextBlock x:ConnectionId='14' x:Name="StatusText" TextWrapping="Wrap" />
                    <TextBlock x:ConnectionId='15' x:Name="HintText" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:ConnectionId='16' x:Name="LinkUrlText" Opacity="0.65" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Connect" />
            <ComboBox x:ConnectionId='2' x:Name="ProfileBox" Header="Entity for new connection" HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:ConnectionId='12' Content="Open Plaid Link in browser"                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:ConnectionId='13' Content="Sandbox one-click"                       />
            </StackPanel>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Paste public_token (advanced)" />
            <TextBox x:ConnectionId='3' x:Name="PublicTokenBox" Header="public_token from Link" PlaceholderText="public-sandbox-…" />
            <TextBox x:ConnectionId='4' x:Name="InstNameBox" Header="Institution name (optional)" />
            <Button x:ConnectionId='5' Content="Exchange token"                        />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Linked items" />
            <ListView x:ConnectionId='6' x:Name="ItemList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Opacity="0.7" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <Button x:ConnectionId='10' Content="Sync now" Tag="{Binding Id}"                    />
                                    <Button x:ConnectionId='11' Content="Disconnect" Tag="{Binding Id}"                          />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:ConnectionId='7' x:Name="MsgText" Opacity="0.85" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <InfoBar x:ConnectionId='8' x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>

