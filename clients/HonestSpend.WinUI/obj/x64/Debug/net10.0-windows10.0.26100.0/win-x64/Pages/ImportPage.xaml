<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="720">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Import" />
                <TextBlock Opacity="0.75" TextWrapping="Wrap"
                    Text="Freeware path: download CSV from your bank (no passwords here), drop in inbox or pick a file. Plaid is optional BYOK." />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="How to download from your bank" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="We never store bank logins. Open your bank, export CSV, then import below or drop into the inbox." />
                    <ComboBox x:ConnectionId='33' x:Name="BankGuideBox" Header="Institution" HorizontalAlignment="Stretch"
                                                                   />
                    <HyperlinkButton x:ConnectionId='34' x:Name="BankLoginLink" Content="Open bank login" NavigateUri="https://example.com"
                                     Visibility="Collapsed" />
                    <TextBlock x:ConnectionId='35' x:Name="BankStepsText" Opacity="0.9" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:ConnectionId='36' x:Name="BankNotesText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Inbox drop folder" />
                    <TextBlock x:ConnectionId='27' x:Name="InboxPathText" Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Text="…" />
                    <TextBlock x:ConnectionId='28' x:Name="InboxFilesText" Opacity="0.85" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='30' Content="Open inbox folder"                         />
                        <Button x:ConnectionId='31' Content="Import inbox now"                          
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:ConnectionId='32' Content="Refresh"                            />
                    </StackPanel>
                    <CheckBox x:ConnectionId='29' x:Name="InboxUseSelectedAccountBox"
                              Content="Unmatched files → use Target account below (off = refuse unmatched)"
                              IsChecked="False" />
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Name files with account nicknames (e.g. Primary-checking.csv). Unmatched files are refused unless you opt in above." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Bank CSV (pick file)" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Export from Chase, Amex, etc. Map to one HonestSpend account. Duplicates skipped." />
                    <ComboBox x:ConnectionId='10' x:Name="AccountBox" Header="Target account" HorizontalAlignment="Stretch" />
                    <ComboBox x:ConnectionId='11' x:Name="SignBox" Header="Amount sign" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Bank style (expenses negative)" Tag="bank" />
                        <ComboBoxItem Content="Invert signs" Tag="invert" />
                    </ComboBox>
                    <CheckBox x:ConnectionId='12' x:Name="AutoCatBox" Content="Auto-categorize after import" IsChecked="True" />
                    <TextBox x:ConnectionId='13' x:Name="EndingBalanceBox" Header="Bank ending balance (optional)"
                             PlaceholderText="From CSV Balance column, or type statement balance"
                             HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='23' Content="Pick CSV…"                       Style="{StaticResource AccentButtonStyle}" />
                        <Button x:ConnectionId='24' Content="Pick OFX/QFX…"                       />
                        <Button x:ConnectionId='25' Content="Pick PDF statement…"                       />
                        <TextBlock x:ConnectionId='26' x:Name="CsvPathText" VerticalAlignment="Center" Opacity="0.75" Text="No file" />
                    </StackPanel>
                    <Button x:ConnectionId='14' Content="Preview mapping"                          />
                    <TextBlock x:ConnectionId='15' x:Name="PreviewText" Opacity="0.85" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='21' Content="Import file"                         Style="{StaticResource AccentButtonStyle}" />
                        <Button x:ConnectionId='22' Content="Import PDF statement"                         />
                    </StackPanel>
                    <TextBlock x:ConnectionId='16' x:Name="ResultText" Opacity="0.9" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel x:ConnectionId='17' x:Name="NextStepsPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button x:ConnectionId='18' x:Name="SetBooksFromBankBtn" Content="Set Safe to spend from bank"
                                                               Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                        <Button x:ConnectionId='19' x:Name="GoSortBtn" Content="Sort charges"                      Visibility="Collapsed" />
                        <Button x:ConnectionId='20' x:Name="GoHomeBtn" Content="Home"                      Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Best: CSV or OFX/QFX. Ending balance → Match bank. New rows update books balance. One-tap Set Safe to spend from bank when bank bal differs." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Legacy Budget.xlsx" />
                    <ComboBox x:ConnectionId='5' x:Name="ProfileSlugBox" Header="Entity" SelectedIndex="0" HorizontalAlignment="Stretch" />
                    <CheckBox x:ConnectionId='6' x:Name="DryRunBox" Content="Dry run (scan only)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='8' Content="Pick xlsx…"                        Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock x:ConnectionId='9' x:Name="XlsxPathText" VerticalAlignment="Center" Opacity="0.75" Text="No file" />
                    </StackPanel>
                    <Button x:ConnectionId='7' Content="Import xlsx"                          />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Plaid" />
                    <TextBlock x:ConnectionId='3' x:Name="PlaidText" Opacity="0.8" TextWrapping="Wrap" Text="Checking…" />
                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                        Text="Full connect / sync is under Banks (Plaid) in the nav. This is status only." />
                    <Button x:ConnectionId='4' Content="Refresh Plaid status"                     />
                </StackPanel>
            </Border>

            <InfoBar x:ConnectionId='2' x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>

