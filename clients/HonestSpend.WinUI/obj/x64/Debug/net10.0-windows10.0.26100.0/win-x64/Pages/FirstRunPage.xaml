<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="14" MaxWidth="520">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Welcome" />
            <TextBlock x:ConnectionId='2' x:Name="StepLabel" Opacity="0.7" />
            <TextBlock x:ConnectionId='3' x:Name="QuestionText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:ConnectionId='4' x:Name="HintText" Opacity="0.8" TextWrapping="Wrap" />

            <StackPanel x:ConnectionId='5' x:Name="Fields" Spacing="12" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:ConnectionId='8' x:Name="BackBtn" Content="Back"                    />
                <Button x:ConnectionId='9' x:Name="NextBtn" Content="Next" Style="{StaticResource AccentButtonStyle}"                    />
                <Button x:ConnectionId='10' Content="Skip for now"                    />
            </StackPanel>
            <TextBlock x:ConnectionId='6' x:Name="MsgText" TextWrapping="Wrap" Opacity="0.9" />
            <InfoBar x:ConnectionId='7' x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>

