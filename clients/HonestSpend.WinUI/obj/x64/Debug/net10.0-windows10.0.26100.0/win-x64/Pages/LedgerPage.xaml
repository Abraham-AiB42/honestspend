<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.LedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="1000">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Ledger" />
                    <TextBlock Opacity="0.7" Text="Recent transactions · assign categories" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <CheckBox x:ConnectionId='21' x:Name="UncatBox" Content="Uncategorized only"                                                     />
                    <Button x:ConnectionId='22' Content="Refresh"                       />
                </StackPanel>
            </Grid>

            <Border Padding="12" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Bulk categorize" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                        Text="Check rows below, pick a category, Apply. Learns a rule from the first payee." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='17' Content="Select all"                         />
                        <Button x:ConnectionId='18' Content="Clear"                              />
                        <ComboBox x:ConnectionId='19' x:Name="BulkCatBox" Header="Category" MinWidth="220" PlaceholderText="Pick category" />
                        <Button x:ConnectionId='20' Content="Apply to selected"                        
                                Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:ConnectionId='16' x:Name="BulkStatusText" Opacity="0.75" FontSize="12" />
                </StackPanel>
            </Border>

            <ListView x:ConnectionId='2' x:Name="TxnList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" MinWidth="32" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Opacity="0.7" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:ConnectionId='15'
                                    Grid.Column="2"
                                    MinWidth="200"
                                    ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                    PlaceholderText="Category"
                                    Tag="{Binding Id}"
                                                                        />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add transaction" />
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:ConnectionId='8' x:Name="ProfileBox" Header="Entity"                                    Grid.Row="0" Grid.Column="0" />
                <ComboBox x:ConnectionId='9' x:Name="AccountBox" Header="Account" Grid.Row="0" Grid.Column="1" />
                <CalendarDatePicker x:ConnectionId='10' x:Name="DateBox" Header="Date" Grid.Row="1" Grid.Column="0" />
                <NumberBox x:ConnectionId='11' x:Name="AmtBox" Header="Amount (+ in / − out)" Grid.Row="1" Grid.Column="1" />
                <TextBox x:ConnectionId='12' x:Name="PayeeBox" Header="Payee" Grid.Row="2" Grid.Column="0" />
                <ComboBox x:ConnectionId='13' x:Name="CatBox" Header="Category" Grid.Row="2" Grid.Column="1" />
            </Grid>
            <Button x:ConnectionId='3' Content="Add transaction"                   Style="{StaticResource AccentButtonStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:ConnectionId='6' x:Name="VoidTxnBox" Header="Void transaction" MinWidth="320" PlaceholderText="Pick by name" />
                <Button x:ConnectionId='7' Content="Void / reverse"                    VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:ConnectionId='4' x:Name="MsgText" Opacity="0.8" TextWrapping="Wrap" />
            <InfoBar x:ConnectionId='5' x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>

