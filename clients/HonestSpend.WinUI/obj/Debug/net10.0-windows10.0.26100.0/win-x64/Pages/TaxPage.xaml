<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.TaxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="960">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Tax packet" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="IRS-mapped COA → TurboTax/CPA export. Multi-state notes for CPA — not tax advice." />
                </StackPanel>
                <Button x:ConnectionId='26' Grid.Column="1" Content="Refresh"                       />
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Chart of accounts" />
                    <TextBlock x:ConnectionId='24' x:Name="CoaText" Opacity="0.85" TextWrapping="Wrap" />
                    <ItemsControl x:ConnectionId='25' x:Name="CoaForms" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Entity tax geo" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:ConnectionId='19' x:Name="ProfileBox" Header="Entity" HorizontalAlignment="Stretch"
                                                                     />
                        <TextBox x:ConnectionId='20' x:Name="HomeStateBox" Header="Home state (e.g. TX)" Grid.Column="1"
                                 MaxLength="8" />
                        <CheckBox x:ConnectionId='21' x:Name="MultiStateBox" Content="Multi-state filer" Grid.Row="1" Grid.Column="0" />
                        <TextBox x:ConnectionId='22' x:Name="AllocBox" Header='State allocation JSON e.g. [{"state":"TX","pct":70}]'
                                 Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                        <TextBox x:ConnectionId='23' x:Name="NotesBox" Header="Filing notes for CPA" Grid.Row="2" Grid.ColumnSpan="2"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="64" />
                    </Grid>
                    <Button x:ConnectionId='18' Content="Save entity tax fields"                           Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Build packet" />
                    <NumberBox x:ConnectionId='7' x:Name="YearBox" Header="Tax year" Minimum="2000" Maximum="2100"
                               SpinButtonPlacementMode="Inline" />
                    <TextBlock x:ConnectionId='8' x:Name="ReadyText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl x:ConnectionId='9' x:Name="ReadyIssues" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='13' Content="Check readiness"                     />
                        <Button x:ConnectionId='14' Content="Preview"                       Style="{StaticResource AccentButtonStyle}" />
                        <Button x:ConnectionId='15' Content="Save ZIP…"                        />
                        <Button x:ConnectionId='16' Content="CPA pack ZIP…"                       />
                        <Button x:ConnectionId='17' Content="Write to engine data dir"                     />
                    </StackPanel>
                    <TextBlock x:ConnectionId='10' x:Name="PacketMeta" Opacity="0.8" TextWrapping="Wrap" />
                    <TextBlock x:ConnectionId='11' x:Name="DisclaimerText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:ConnectionId='12' x:Name="TokenText" Opacity="0.9" FontFamily="Consolas" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="By tax line" />
            <ListView x:ConnectionId='2' x:Name="LineList" SelectionMode="None" MaxHeight="360">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.75" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Needs category / nontax" />
            <ItemsControl x:ConnectionId='3' x:Name="UncatList" />

            <TextBlock x:ConnectionId='4' x:Name="MsgText" Opacity="0.85" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <InfoBar x:ConnectionId='5' x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>

