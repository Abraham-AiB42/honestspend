<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="640">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="HonestSpend" />
            <TextBlock x:ConnectionId='2' x:Name="VersionText" Opacity="0.8" Text="Connecting…" />
            <TextBlock x:ConnectionId='3' x:Name="MaturityText" Opacity="0.75" TextWrapping="Wrap"
                Text="Local multi-entity liquidity OS." />
            <TextBlock TextWrapping="Wrap" FontSize="16">
                Open-source freeware — not a bureau, not e-file, not payroll, not a loan marketplace.
            </TextBlock>
            <TextBlock Opacity="0.8" TextWrapping="Wrap">
                • Never bounce checking&#x0a;
                • Prefer interest-free card float when it's safe&#x0a;
                • Catch dumb fees and unnecessary interest&#x0a;
                • Don't prepay cheap debt when cash yields more&#x0a;
                • Stay solvent first · credit health second&#x0a;
                • Local data + backup · open rarely
            </TextBlock>
            <TextBlock Opacity="0.7" TextWrapping="Wrap">
                Client-first: native WinUI is the product. Simple for daily use, Full books for ledgers/tax.
                Engine stays local on port 7420. No PWA — Glance is a thin browser fallback only.
            </TextBlock>
            <TextBlock Opacity="0.65" TextWrapping="Wrap" FontSize="12"
                Text="What's new in 1.0.x: scenarios UI, dogfood e2e, client-first policy, tray opens desktop app, Windows task registration from Settings." />
            <TextBlock x:ConnectionId='4' x:Name="PathsText" Opacity="0.65" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:ConnectionId='5' x:Name="LicenseText" Opacity="0.7" Text="MIT License · freeware · pre-1.0" />
        </StackPanel>
    </ScrollViewer>
</Page>

