<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.AuditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="900">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Audit log" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                        Text="Who did what on this machine — multi-user trail. Full books only." />
                </StackPanel>
                <Button x:ConnectionId='7' Grid.Column="1" Content="Refresh"                       />
            </Grid>

            <NumberBox x:ConnectionId='2' x:Name="LimitBox" Header="Max events" Minimum="10" Maximum="200" Value="50" />
            <TextBlock x:ConnectionId='3' x:Name="StatusText" Opacity="0.8" />
            <ListView x:ConnectionId='4' x:Name="EventList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.7" FontSize="12" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <InfoBar x:ConnectionId='5' x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>

