<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.IntermixPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Entity intermix" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                Text="Reimburse, distributions, capital injects — paired transfers so personal/business books stay clean. Not tax advice." />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Playbooks" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:ConnectionId='14' Content="Reimburse card from biz"                        />
                <Button x:ConnectionId='15' Content="Quarterly distribution"                   />
                <Button x:ConnectionId='16' Content="Capital inject"                     />
                <Button x:ConnectionId='17' Content="Child allowance"                        />
            </StackPanel>
            <TextBlock x:ConnectionId='2' x:Name="PlaybookHint" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />

            <ComboBox x:ConnectionId='3' x:Name="KindBox" Header="Type" SelectedIndex="0" MinWidth="320">
                <ComboBoxItem Content="Reimburse (biz → personal)" Tag="reimburse" />
                <ComboBoxItem Content="Distribution (biz → personal)" Tag="distribution" />
                <ComboBoxItem Content="Capital inject (personal → biz)" Tag="capital_inject" />
                <ComboBoxItem Content="Owner draw (biz → personal)" Tag="owner_draw" />
                <ComboBoxItem Content="Child allowance (personal → child)" Tag="child_allowance" />
            </ComboBox>

            <NumberBox x:ConnectionId='4' x:Name="AmtBox" Header="Amount ($)" Minimum="0.01" Value="100" />
            <ComboBox x:ConnectionId='5' x:Name="FromBox" Header="From account" HorizontalAlignment="Stretch" />
            <ComboBox x:ConnectionId='6' x:Name="ToBox" Header="To account" HorizontalAlignment="Stretch" />
            <TextBox x:ConnectionId='7' x:Name="MemoBox" Header="Memo" PlaceholderText="Optional" />

            <Button x:ConnectionId='8' Content="Record intermix"                    Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:ConnectionId='9' x:Name="ResultText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Money map (transfer edges)" />
            <Button x:ConnectionId='10' Content="Refresh graph"                     />
            <ItemsControl x:ConnectionId='11' x:Name="GraphList" />
            <TextBlock x:ConnectionId='12' x:Name="GraphMsg" Opacity="0.75" TextWrapping="Wrap" />

            <InfoBar x:ConnectionId='13' x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</Page>

