<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HonestSpend_WinUI.Pages.AddHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Add something" />
            <TextBlock Opacity="0.8" TextWrapping="Wrap"
                Text="Short wizards. No jargon. We'll only ask what we need to keep you safe." />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Money accounts" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:ConnectionId='10' Content="Checking / cash" Tag="cash"                   
                        HorizontalAlignment="Stretch" Padding="16" Grid.Row="0" Grid.Column="0" />
                <Button x:ConnectionId='11' Content="Savings / HYSA" Tag="savings"                   
                        HorizontalAlignment="Stretch" Padding="16" Grid.Row="0" Grid.Column="1" />
                <Button x:ConnectionId='12' Content="Credit card" Tag="card"                   
                        HorizontalAlignment="Stretch" Padding="16" Grid.Row="1" Grid.Column="0" />
                <Button x:ConnectionId='13' Content="Loan / mortgage" Tag="loan"                   
                        HorizontalAlignment="Stretch" Padding="16" Grid.Row="1" Grid.Column="1" />
            </Grid>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Recurring" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:ConnectionId='8' Content="Bill (money out)" Tag="bill"                   
                        HorizontalAlignment="Stretch" Padding="16" />
                <Button x:ConnectionId='9' Content="Income (money in)" Tag="income"                   
                        HorizontalAlignment="Stretch" Padding="16" Grid.Column="1" />
            </Grid>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="People / entities" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:ConnectionId='6' Content="Business" Tag="business"                   
                        HorizontalAlignment="Stretch" Padding="16" />
                <Button x:ConnectionId='7' Content="Child" Tag="child"                   
                        HorizontalAlignment="Stretch" Padding="16" Grid.Column="1" />
            </Grid>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Move money" />
            <Button x:ConnectionId='2' Content="Playbooks — reimburse · pay myself · kid allowance"
                                            HorizontalAlignment="Stretch" Padding="16" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Banks &amp; files" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:ConnectionId='4' Content="Link bank (Plaid)"                   
                        HorizontalAlignment="Stretch" Padding="16" />
                <Button x:ConnectionId='5' Content="Import CSV"                     
                        HorizontalAlignment="Stretch" Padding="16" Grid.Column="1" />
            </Grid>
            <TextBlock Opacity="0.65" TextWrapping="Wrap"
                Text="Optional. Manual balances work fine — link banks when you want less typing." />
            <InfoBar x:ConnectionId='3' x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>

